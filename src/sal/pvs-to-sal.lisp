;;; A finite, shallow compiler from typechecked PVS values to SAL relations.
;;; No evaluator, proof rewriting, axioms, or user judgements establish admission.
(in-package :pvs)

(define-condition sal-pvs-admission-error (error)
  ((object :initarg :object :reader sal-pvs-admission-object)
   (reason :initarg :reason :reader sal-pvs-admission-reason))
  (:report (lambda (condition stream)
             (format stream "PVS-to-SAL admission failed: ~a~%  ~a"
                     (sal-pvs-admission-reason condition)
                     (sal-pvs-admission-object condition)))))

(defstruct sal-pvs2sal-renderer
  declarations instances operations active enum-types type-declarations array-indices
  (serial 0) (type-cache (make-hash-table :test #'eq)) active-types)

(defvar *sal-pvs2sal-renderer*)

(declaim (ftype function sal-pvs2sal-type sal-pvs2sal-type-uncached
                sal-pvs2sal-call sal-pvs2sal-expression))

(defun sal-pvs2sal-reject (object control &rest arguments)
  (error 'sal-pvs-admission-error :object object
         :reason (apply #'format nil control arguments)))

(defun sal-pvs2sal-identifier (object)
  ;; Encode underscores as well as punctuation, so the encoding is injective.
  (concatenate
   'string "pvs_"
   (with-output-to-string (out)
     (loop for ch across (string object) do
       (if (or (find ch "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")
               (find ch "0123456789"))
           (write-char ch out)
           (format out "_x~x_" (char-code ch)))))))

(defun sal-pvs2sal-fresh (stem)
  (format nil "pvs_~a_~d" stem (incf (sal-pvs2sal-renderer-serial *sal-pvs2sal-renderer*))))

(defun sal-pvs2sal-original-prelude-p (declaration)
  ;; from-prelude? checks only the module identifier.  Require the actual
  ;; prelude module and declaration objects, not a user declaration's spelling.
  (and (declaration? declaration)
       (module declaration)
       (eq (module declaration)
           (gethash (id (module declaration)) *prelude*))
       (member declaration (theory (module declaration)) :test #'eq)))

(defun sal-pvs2sal-note-declaration (declaration &optional instance)
  (unless (or (binding? declaration) (sal-pvs2sal-original-prelude-p declaration))
    (pushnew declaration (sal-pvs2sal-renderer-declarations *sal-pvs2sal-renderer*) :test #'eq)
    (when instance
      (pushnew (cons declaration instance)
               (sal-pvs2sal-renderer-instances *sal-pvs2sal-renderer*)
               :test (lambda (a b) (and (eq (car a) (car b))
                                        (tc-eq (cdr a) (cdr b))))))))

(defun sal-pvs2sal-note-type-name (type)
  (let ((name (if (type-name? type) type (print-type type))))
    (when (and (type-name? name) (resolution name))
      (sal-pvs2sal-note-declaration (declaration name) (module-instance name)))))

(defun sal-pvs2sal-builtin (name)
  (when (and (name-expr? name) (resolution name)
             (or (null (module-instance name))
                 (null (mappings (module-instance name)))))
    (let ((decl (declaration name)))
      (when (sal-pvs2sal-original-prelude-p decl)
        (let ((theory (string (id (module decl)))) (id (string (id decl))))
          (cond ((string= theory "booleans")
                 (or (cdr (assoc id '(("&" . "AND") ("∧" . "AND") ("∨" . "OR")
                                     ("¬" . "NOT") ("=>" . "IMPLIES") ("⇒" . "IMPLIES")
                                     ("<=>" . "IFF") ("⇔" . "IFF")) :test #'string=))
                     (and (member id '("TRUE" "FALSE" "NOT" "AND" "OR"
                                       "IMPLIES" "IFF" "WHEN") :test #'string=) id)))
                ((and (string= theory "equalities") (string= id "=")) id)
                ((and (string= theory "notequal")
                      (member id '("/=" "≠") :test #'string=)) "/=")
                ((and (string= theory "xor_def") (string= id "XOR")) id)
                ((and (string= theory "if_def") (string= id "IF")) id)
                ((and (string= theory "number_fields")
                      (member id '("+" "-" "*") :test #'string=)) id)
                ((and (string= theory "reals")
                      (member id '("<" "<=" ">" ">=") :test #'string=)) id)))))))

(defun sal-pvs2sal-arguments (application)
  (let ((argument (argument application)))
    (if (arg-tuple-expr? argument) (exprs argument) (list argument))))

(defun sal-pvs2sal-specialized-definition (name)
  (unless (and (name-expr? name) (resolution name))
    (sal-pvs2sal-reject name "expected a resolved PVS definition"))
  (let ((decl (declaration name)))
    (sal-pvs2sal-note-declaration decl (module-instance name))
    (when (or (def-decl? decl) (fixpoint-decl? decl) (corecursive-decl? decl))
      (sal-pvs2sal-reject name "recursive and fixed point definitions are not admitted"))
    (unless (and (const-decl? decl) (definition decl))
      (sal-pvs2sal-reject name "opaque or uninterpreted constant ~a has no executable definition" (id decl)))
    (when (sal-pvs2sal-original-prelude-p decl)
      (sal-pvs2sal-reject name "prelude operation ~a has no audited SAL translation" (id decl)))
    (let* ((body (make!-lambda-exprs (formals decl) (definition decl) (type decl)))
           (instance (module-instance name)))
      (if instance (subst-mod-params body instance (module decl) decl) body))))

(defmacro sal-pvs2sal-expanding (name &body body)
  `(let ((decl (declaration ,name)))
     (when (member decl (sal-pvs2sal-renderer-active *sal-pvs2sal-renderer*) :test #'eq)
       (sal-pvs2sal-reject ,name "cyclic definition expansion"))
     (let ((old (sal-pvs2sal-renderer-active *sal-pvs2sal-renderer*)))
       (unwind-protect
           (progn (push decl (sal-pvs2sal-renderer-active *sal-pvs2sal-renderer*)) ,@body)
         (setf (sal-pvs2sal-renderer-active *sal-pvs2sal-renderer*) old)))))

(defun sal-pvs2sal-beta-body (lambda arguments)
  (unless (= (length (bindings lambda)) (length arguments))
    (sal-pvs2sal-reject lambda "function application arity does not match its bindings"))
  ;; Native capture-avoiding substitution also substitutes dependent types.
  (substit (expression lambda) (pairlis (bindings lambda) arguments)))

(defun sal-pvs2sal-head (expression)
  "Expand pure definitions and beta redexes only, without theorem rewriting."
  (cond ((and (name-expr? expression) (resolution expression)
              (const-decl? (declaration expression))
              (not (sal-pvs2sal-builtin expression))
              (not (adt-constructor-decl? (declaration expression)))
              (not (adt-recognizer-decl? (declaration expression))))
         (sal-pvs2sal-expanding expression
           (sal-pvs2sal-head (sal-pvs2sal-specialized-definition expression))))
        ((and (application? expression)
              (not (sal-pvs2sal-builtin (operator expression))))
         (let ((head (sal-pvs2sal-head (operator expression))))
           (if (lambda-expr? head)
               (sal-pvs2sal-head (sal-pvs2sal-beta-body head (sal-pvs2sal-arguments expression)))
               expression)))
        (t expression)))

(defun sal-pvs2sal-closed-integer (expression)
  (let ((expr (sal-pvs2sal-head expression)))
    (cond ((and (rational-expr? expr) (integerp (number expr))) (number expr))
          ((application? expr)
           (let ((op (sal-pvs2sal-builtin (operator expr)))
                 (args (sal-pvs2sal-arguments expr)))
             (when (member op '("+" "-" "*") :test #'equal)
               (let ((numbers (mapcar #'sal-pvs2sal-closed-integer args)))
                 (when (and (every #'integerp numbers)
                            (or (= (length numbers) 2)
                                (and (equal op "-") (= (length numbers) 1))))
                   (apply (cond ((equal op "+") #'+)
                                ((equal op "-") #'-) (t #'*)) numbers)))))))))

(defun sal-pvs2sal-integer-carrier-p (type)
  ;; A syntactic supertype chain, deliberately independent of PVS judgements.
  (or (tc-eq type *integer*)
      (and (subtype? type) (sal-pvs2sal-integer-carrier-p (supertype type)))))

(defun sal-pvs2sal-predicate-lambda (predicate)
  (let ((head (sal-pvs2sal-head predicate)))
    (unless (and (lambda-expr? head) (= (length (bindings head)) 1))
      (sal-pvs2sal-reject predicate "a subtype predicate must reduce to a unary definition"))
    head))

(defun sal-pvs2sal-predicate-bounds (predicate)
  (let* ((lambda (sal-pvs2sal-predicate-lambda predicate))
         (variable (car (bindings lambda))) (lower nil) (upper nil))
    (labels ((var-p (x) (and (name-expr? x) (eq (declaration x) variable)))
             (lower (n) (when n (setf lower (if lower (max lower n) n))))
             (upper (n) (when n (setf upper (if upper (min upper n) n))))
             (scan (x)
               (setf x (sal-pvs2sal-head x))
               (when (application? x)
                 (let ((op (sal-pvs2sal-builtin (operator x)))
                       (args (sal-pvs2sal-arguments x)))
                   (cond ((equal op "AND") (mapc #'scan args))
                         ((and (= (length args) 2)
                               (member op '("<" "<=" ">" ">=" "=") :test #'equal))
                          (let* ((left (first args)) (right (second args))
                                 (l (unless (var-p left) (sal-pvs2sal-closed-integer left)))
                                 (r (unless (var-p right) (sal-pvs2sal-closed-integer right))))
                            (cond ((and (var-p left) r)
                                   (cond ((equal op "<") (upper (1- r)))
                                         ((equal op "<=") (upper r))
                                         ((equal op ">") (lower (1+ r)))
                                         ((equal op ">=") (lower r))
                                         ((equal op "=") (lower r) (upper r))))
                                  ((and l (var-p right))
                                   (cond ((equal op "<") (lower (1+ l)))
                                         ((equal op "<=") (lower l))
                                         ((equal op ">") (upper (1- l)))
                                         ((equal op ">=") (upper l))
                                         ((equal op "=") (lower l) (upper l))))))))))))
      (scan (expression lambda)))
    (values lower upper)))

(defun sal-pvs2sal-integer-domain (type)
  "Return finite bounding interval and all predicates down to the integer carrier."
  (let ((lower nil) (upper nil) (predicates nil))
    (loop for current = type then (supertype current) do
      (sal-pvs2sal-note-type-name current)
      (when (tc-eq current *integer*) (return))
      (unless (subtype? current)
        (sal-pvs2sal-reject type "expected a syntactic integer subtype"))
      (if (tc-eq current *naturalnumber*)
          (setf lower (if lower (max lower 0) 0))
          (progn
            (push (predicate current) predicates)
            (multiple-value-bind (lo hi) (sal-pvs2sal-predicate-bounds (predicate current))
              (when lo (setf lower (if lower (max lower lo) lo)))
              (when hi (setf upper (if upper (min upper hi) hi)))))))
    (unless (and lower upper)
      (sal-pvs2sal-reject type "unbounded integer carrier; finite lower and upper bounds must follow syntactically from subtype conjunctions"))
    (when (> lower upper)
      (sal-pvs2sal-reject type "statically empty integer carrier"))
    (values lower upper (nreverse predicates))))

(defun sal-pvs2sal-enum-type (type)
  (let ((found (find type (sal-pvs2sal-renderer-enum-types *sal-pvs2sal-renderer*)
                     :key #'first :test #'tc-eq)))
    (if found (second found)
        (let* ((adt (adt type)) (constructors (constructors adt))
               (name (sal-pvs2sal-fresh "enum")))
          (unless (and (enumtype? adt) constructors
                       (every (lambda (c) (null (arguments c))) constructors))
            (sal-pvs2sal-reject type "only scalar enumerations are admitted from PVS datatypes"))
          (let ((entries (mapcar (lambda (c)
                                  (cons (con-decl c)
                                        (format nil "~a_~a" name (sal-pvs2sal-identifier (id c)))))
                                constructors)))
            (push (list type name entries) (sal-pvs2sal-renderer-enum-types *sal-pvs2sal-renderer*))
            (push (format nil "  ~a: TYPE = {~{~a~^, ~}};~%" name (mapcar #'cdr entries))
                  (sal-pvs2sal-renderer-type-declarations *sal-pvs2sal-renderer*))
            name)))))

(defun sal-pvs2sal-array-index-type (type)
  (or (cdr (assoc type (sal-pvs2sal-renderer-array-indices *sal-pvs2sal-renderer*) :test #'tc-eq))
      (let ((index (sal-pvs2sal-fresh "index")) (domain (sal-pvs2sal-type type)))
        (push (cons type index) (sal-pvs2sal-renderer-array-indices *sal-pvs2sal-renderer*))
        (push (format nil "  ~a: TYPE = ~a;~%" index domain)
              (sal-pvs2sal-renderer-type-declarations *sal-pvs2sal-renderer*))
        index)))

(defun sal-pvs2sal-type (type)
  (sal-pvs2sal-note-type-name type)
  (or (gethash type (sal-pvs2sal-renderer-type-cache *sal-pvs2sal-renderer*))
      (let ((old (sal-pvs2sal-renderer-active-types *sal-pvs2sal-renderer*)))
        (when (member type old :test #'eq)
          (sal-pvs2sal-reject type "cyclic type"))
        (unwind-protect
            (progn
              (push type (sal-pvs2sal-renderer-active-types *sal-pvs2sal-renderer*))
              (setf (gethash type (sal-pvs2sal-renderer-type-cache *sal-pvs2sal-renderer*))
                    (sal-pvs2sal-type-uncached type)))
          (setf (sal-pvs2sal-renderer-active-types *sal-pvs2sal-renderer*) old)))))

(defun sal-pvs2sal-type-uncached (type)
  (cond ((tc-eq type *boolean*) "BOOLEAN")
        ((sal-pvs2sal-integer-carrier-p type)
         (multiple-value-bind (lo hi predicates) (sal-pvs2sal-integer-domain type)
           (let ((variable (sal-pvs2sal-fresh "subtype")))
             (if predicates
                 (format nil "{~a: [~d..~d] | ~{~a~^ AND ~}}" variable lo hi
                         (mapcar (lambda (p) (sal-pvs2sal-call p (list variable) nil)) predicates))
                 (format nil "[~d..~d]" lo hi)))))
        ((subtype? type)
         (let ((base (sal-pvs2sal-type (supertype type)))
               (variable (sal-pvs2sal-fresh "subtype")))
           (format nil "{~a: ~a | ~a}" variable base
                   (sal-pvs2sal-call (predicate type) (list variable) nil))))
        ((recordtype? type)
         (when (dependent? type) (sal-pvs2sal-reject type "dependent records are not yet admitted"))
         (format nil "[# ~{~a~^, ~} #]"
                 (mapcar (lambda (field)
                           (format nil "~a: ~a" (sal-pvs2sal-identifier (id field))
                                   (sal-pvs2sal-type (type field)))) (fields type))))
        ((tupletype? type)
         (when (some #'dep-binding? (types type))
           (sal-pvs2sal-reject type "dependent tuple types are not admitted"))
         (format nil "[~{~a~^, ~}]" (mapcar #'sal-pvs2sal-type (types type))))
        ((funtype? type)
         (when (dep-binding? (domain type))
           (sal-pvs2sal-reject type "dependent function types are not admitted"))
         ;; SAL requires an index name (or a literal interval), even though a
         ;; finite predicate subtype is admissible as the named index domain.
         (format nil "ARRAY ~a OF ~a" (sal-pvs2sal-array-index-type (domain type))
                 (sal-pvs2sal-type (range type))))
        ((adt-type-name? type) (sal-pvs2sal-enum-type type))
        ((type-name? type)
         (let* ((decl (declaration type)) (value (and (type-decl? decl) (type-value decl))))
           (unless (and value (not (tc-eq value type)))
             (sal-pvs2sal-reject type "opaque or infinite type has no admitted finite carrier"))
           (sal-pvs2sal-type (subst-mod-params value (module-instance type) (module decl) decl))))
        (t (sal-pvs2sal-reject type "unsupported finite-state type ~a" (type-of type)))))

(defun sal-pvs2sal-call (function arguments environment)
  "Apply a typed PVS function to already rendered SAL values."
  (cond ((lambda-expr? function)
         (unless (= (length (bindings function)) (length arguments))
           (sal-pvs2sal-reject function "unsupported curried or tuple function application"))
         (sal-pvs2sal-expression (expression function)
                             (append (pairlis (bindings function) arguments) environment)))
        ((and (recognizer-name-expr? function)
              (adt-recognizer-decl? (declaration function)))
         (unless (= (length arguments) 1)
           (sal-pvs2sal-reject function "scalar recognizer arity"))
         (format nil "(~a = ~a)" (first arguments)
                 (sal-pvs2sal-expression (constructor function) environment)))
        ((and (name-expr? function) (not (assoc (declaration function) environment)))
         (sal-pvs2sal-expanding function
           (sal-pvs2sal-call (sal-pvs2sal-specialized-definition function) arguments environment)))
        (t
         ;; A finite PVS function value is represented by a SAL array.
         (unless (= (length arguments) 1)
           (sal-pvs2sal-reject function "array application requires one argument"))
         (sal-pvs2sal-type (type function))
         (format nil "(~a)[~a]" (sal-pvs2sal-expression function environment) (first arguments)))))

(defun sal-pvs2sal-builtin-expression (expression op environment)
  (pushnew op (sal-pvs2sal-renderer-operations *sal-pvs2sal-renderer*) :test #'equal)
  (let* ((args (sal-pvs2sal-arguments expression))
         (values (mapcar (lambda (x) (sal-pvs2sal-expression x environment)) args)))
    (cond ((and (equal op "IF") (= (length values) 3))
           (format nil "(IF ~a THEN ~a ELSE ~a ENDIF)" (first values) (second values) (third values)))
          ((and (equal op "NOT") (= (length values) 1))
           (format nil "(NOT ~a)" (first values)))
          ((and (equal op "-") (= (length values) 1))
           (format nil "(-~a)" (first values)))
          ((and (member op '("+" "-" "*" "<" "<=" ">" ">=" "=" "/="
                            "AND" "OR" "XOR" "IMPLIES" "IFF" "WHEN") :test #'equal)
                (= (length values) 2))
           (if (equal op "WHEN")
               (format nil "(~a => ~a)" (second values) (first values))
               (format nil "(~a ~a ~a)" (first values)
                       (cond ((equal op "IMPLIES") "=>") ((equal op "IFF") "<=>") (t op))
                       (second values))))
          (t (sal-pvs2sal-reject expression "unsupported builtin arity")))))

(defun sal-pvs2sal-assignment-field (assignment)
  (let ((args (arguments assignment)))
    (unless (and (= (length args) 1) (= (length (car args)) 1)
                 (name-expr? (caar args)))
      (sal-pvs2sal-reject assignment "only direct record-field assignments are admitted"))
    (sal-pvs2sal-identifier (id (caar args)))))

(defun sal-pvs2sal-expression (expression environment)
  (cond
    ((rational-expr? expression)
     (unless (integerp (number expression))
       (sal-pvs2sal-reject expression "noninteger numeric values are not admitted"))
     (format nil "~d" (number expression)))
    ((name-expr? expression)
     (let ((bound (assoc (declaration expression) environment))
           (builtin (sal-pvs2sal-builtin expression)))
       (cond (bound (cdr bound))
             ((member builtin '("TRUE" "FALSE") :test #'equal) builtin)
             ((adt-constructor-decl? (declaration expression))
              (sal-pvs2sal-type (adt expression))
              (sal-pvs2sal-note-declaration (declaration expression) (module-instance expression))
              (let* ((entry (find (adt expression) (sal-pvs2sal-renderer-enum-types *sal-pvs2sal-renderer*)
                                  :key #'first :test #'tc-eq))
                     (name (cdr (assoc (declaration expression) (third entry)))))
                (or name (sal-pvs2sal-reject expression "non-scalar datatype constructor"))))
             (t (sal-pvs2sal-expanding expression
                  (sal-pvs2sal-expression (sal-pvs2sal-specialized-definition expression) environment))))))
    ((field-application? expression)
     (format nil "(~a).~a" (sal-pvs2sal-expression (argument expression) environment)
             (sal-pvs2sal-identifier (id expression))))
    ((projection-application? expression)
     (format nil "(~a).~d" (sal-pvs2sal-expression (argument expression) environment) (index expression)))
    ((application? expression)
     (let ((builtin (sal-pvs2sal-builtin (operator expression))))
       (if builtin (sal-pvs2sal-builtin-expression expression builtin environment)
           (sal-pvs2sal-call (operator expression)
                         (mapcar (lambda (x) (sal-pvs2sal-expression x environment))
                                 (sal-pvs2sal-arguments expression)) environment))))
    ((record-expr? expression)
     (format nil "(# ~{~a~^, ~} #)"
             (mapcar (lambda (a) (format nil "~a := ~a" (sal-pvs2sal-assignment-field a)
                                        (sal-pvs2sal-expression (expression a) environment)))
                     (assignments expression))))
    ((tuple-expr? expression)
     (format nil "(~{~a~^, ~})"
             (mapcar (lambda (x) (sal-pvs2sal-expression x environment)) (exprs expression))))
    ((update-expr? expression)
     (let ((base (find-supertype (type (expression expression)))))
       (unless (or (recordtype? base) (funtype? base))
         (sal-pvs2sal-reject expression "only direct record and array updates are admitted"))
       (when (and (funtype? base) (> (length (assignments expression)) 1))
         (sal-pvs2sal-reject expression "multiple potentially overlapping array updates are not admitted"))
       (when (recordtype? base)
         (let ((fields (mapcar #'sal-pvs2sal-assignment-field (assignments expression))))
           (unless (= (length fields) (length (remove-duplicates fields :test #'equal)))
             (sal-pvs2sal-reject expression "duplicate record update fields are not admitted"))))
       (reduce (lambda (value assignment) (format nil "(~a WITH ~a)" value assignment))
               (mapcar
                (lambda (a)
                  (let ((target
                         (if (recordtype? base) (format nil ".~a" (sal-pvs2sal-assignment-field a))
                             (let ((args (arguments a)))
                               (unless (and (= (length args) 1) (= (length (car args)) 1))
                                 (sal-pvs2sal-reject a "nested array updates are not admitted"))
                               (format nil "[~a]" (sal-pvs2sal-expression (caar args) environment))))))
                    (format nil "~a := ~a" target (sal-pvs2sal-expression (expression a) environment))))
                (assignments expression))
               :initial-value (sal-pvs2sal-expression (expression expression) environment))))
    ((or (forall-expr? expression) (exists-expr? expression) (lambda-expr? expression))
     (when (lambda-expr? expression)
       (sal-pvs2sal-type (type expression))
       (unless (= (length (bindings expression)) 1)
         (sal-pvs2sal-reject expression "array lambdas require one binding")))
     (let ((env environment) (decls nil))
       (dolist (binding (bindings expression))
         (let ((name (sal-pvs2sal-fresh (sal-pvs2sal-identifier (id binding))))
               (type (if (lambda-expr? expression)
                         (sal-pvs2sal-array-index-type (type binding))
                         (sal-pvs2sal-type (type binding)))))
           (push (format nil "~a: ~a" name type) decls)
           (push (cons binding name) env)))
       (if (lambda-expr? expression)
           (format nil "[[~{~a~^, ~}] ~a]" (nreverse decls)
                   (sal-pvs2sal-expression (expression expression) env))
           (format nil "(~a (~{~a~^, ~}): ~a)"
                   (if (forall-expr? expression) "FORALL" "EXISTS") (nreverse decls)
                   (sal-pvs2sal-expression (expression expression) env)))))
    (t (sal-pvs2sal-reject expression "unsupported PVS expression ~a" (type-of expression)))))

(defun sal-pvs-to-sal-render (state-type initial-expr step-expr property-expr
                            &key (context-name "pvs_transition_system"))
  "Compile concrete, typechecked PVS predicates to a finite SAL state machine.
Returns source, original non-prelude declaration dependencies, and metadata.
The caller must check the originating theory's TCCs before trusting a backend.
The source keeps the complete initialization and transition relations, including
empty successor sets; it does not add stuttering or enumerate reachable states."
  (unless (and (stringp context-name) (plusp (length context-name))
               (find (char context-name 0) "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")
               (every (lambda (c) (find c "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_")) context-name)
               (not (member context-name
                            '("type" "array" "of" "with" "lambda" "forall" "exists" "let" "in"
                              "if" "then" "else" "elsif" "endif" "begin" "end" "rename" "to"
                              "context" "module" "input" "output" "global" "local" "initialization"
                              "definition" "transition" "theorem" "lemma" "claim" "obligation" "observe"
                              "implements" "datatype" "state_type" "init_pred" "trans_pred" "scalarset"
                              "ringset" "importing" "suffix" "prefix") :test #'string-equal)))
    (sal-pvs2sal-reject context-name "context name must be an ASCII SAL identifier"))
  (let* ((*sal-pvs2sal-renderer* (make-sal-pvs2sal-renderer))
         (state (sal-pvs2sal-type state-type))
         (initial (sal-pvs2sal-call initial-expr '("candidate") nil))
         (step (sal-pvs2sal-call step-expr '("state" "candidate") nil))
         (property (sal-pvs2sal-call property-expr '("state") nil)))
    (values
     (with-output-to-string (out)
       (format out "%% Generated from typechecked PVS definitions; finite, relational translation.~%")
       (format out "~a: CONTEXT =~%BEGIN~%" context-name)
       (dolist (declaration (nreverse (sal-pvs2sal-renderer-type-declarations *sal-pvs2sal-renderer*)))
         (write-string declaration out))
       (format out "  State: TYPE = ~a;~%~%" state)
       (format out "  machine: MODULE =~%  BEGIN~%    LOCAL state: State~%")
       (format out "    INITIALIZATION~%      state IN {candidate: State | ~a}~%" initial)
       (format out "    TRANSITION~%      state' IN {candidate: State | ~a}~%  END;~%~%" step)
       (format out "  safety: THEOREM machine |- G(~a);~%END~%" property))
     (nreverse (sal-pvs2sal-renderer-declarations *sal-pvs2sal-renderer*))
     (list :context-name context-name :module-name "machine" :assertion-name "safety"
           :state-type-text state :finite-p t :relational-p t
           :instances (nreverse (sal-pvs2sal-renderer-instances *sal-pvs2sal-renderer*))
           :operations (sort (copy-list (sal-pvs2sal-renderer-operations *sal-pvs2sal-renderer*)) #'string<)))))

(export '(sal-pvs-to-sal-render sal-pvs-admission-error sal-pvs-admission-object
          sal-pvs-admission-reason))
