;;; Executable tutorial and focused regression, loaded after ../demo.lisp.
(in-package :pvs)
(load (merge-pathnames "../tests/support.lisp" *sal-doc-directory*))
(setq *proof-prompt-behavior* :noquestions *proceed-without-asking* t
      *noninteractive* t *noninteractive-timeout* 60)

(defparameter *sal-nary-output*
  (uiop:ensure-directory-pathname (uiop:getenv "SAL_NARY_OUTPUT")))

(defun sal-nary-view (tag &rest args)
  (apply #'sal-doc-nary :output-directory (merge-pathnames tag *sal-nary-output*) args))

(defun sal-nary-snapshot (view tag)
  (let ((destination (merge-pathnames (format nil "nary/generated/~a/" tag)
                                     *sal-doc-directory*)))
    (dolist (file (append (list (sal-transition-view-pvs-file view))
                         (sal-transition-view-context-pvs-files view)
                         (list (merge-pathnames "../theories/SAL_Transition_System.pvs"
                                                *sal-doc-directory*))))
      (let ((target (merge-pathnames (file-namestring file) destination)))
        (ensure-directories-exist target)
        (sal-write-file-if-changed target (uiop:read-file-string file))))
    (with-open-file (out (merge-pathnames "source-tccs.txt" destination)
                         :direction :output :if-exists :supersede)
      (sal-show-obligations view out))))

(defun sal-nary-save-result (view tag)
  (let ((destination (merge-pathnames (format nil "nary/generated/~a/" tag)
                                     *sal-doc-directory*)))
    (ensure-directories-exist (merge-pathnames "checker-result.txt" destination))
    (with-open-file (out (merge-pathnames "checker-result.txt" destination)
                         :direction :output :if-exists :supersede)
      (sal-print-check-result *sal-last-check-result* out))
    (dolist (proof (directory (merge-pathnames "*.prf"
                                  (uiop:pathname-directory-pathname
                                    (sal-transition-view-pvs-file view)))))
      (sal-write-file-if-changed
        (merge-pathnames (file-namestring proof) destination)
        (uiop:read-file-string proof)))))

(defun sal-nary-replay (view property)
  (let* ((th (get-typechecked-theory (sal-transition-view-theory-name view)))
         (imports (reverse (remove-duplicates (cons th (all-importings th)) :test #'eq))))
    (dolist (theory imports)
      (unless (from-prelude? theory)
        (dolist (tcc (collect-tccs theory))
          (sal-test (justification tcc) (format nil "saved TCC ~a" (id tcc)))
          (sal-test (eq (status-flag (prove-decl tcc :strategy '(then (rerun) (quit)))) '!)
                    (format nil "fresh TCC replay ~a" (id tcc)))))))
  (let* ((th (get-typechecked-theory (sal-transition-view-theory-name view)))
         (decl (find (sal-pvs-name property) (theory th)
                     :key (lambda (d) (if (formula-decl? d) (string (id d)) ""))
                     :test #'string=)))
    (sal-test (and decl (justification decl)) "saved SAL strategy proof")
    (sal-test (eq (status-flag (prove-decl decl :strategy '(then (rerun) (quit)))) '!)
              "fresh SAL strategy replay")
    (sal-test (and (proved? decl) (string= (pc-complete decl) "complete"))
              "native theorem is proved - complete")
    (save-all-proofs th t)
    (save-context nil t)))

(handler-case
    (if (string= (uiop:getenv "SAL_NARY_PHASE") "replay")
        (let ((view (sal-nary-view "three/" :n 3)))
          (sal-nary-replay view "aligned")
          (sal-test (eq (sal-check-result-outcome *sal-last-check-result*) :proved)
                    "fresh strategy replay invokes SAL successfully")
          (sal-nary-save-result view "three")
          (format t "~&SAL-NARY-REPLAY-PASSED~%"))
        (progn
          (let* ((generic (sal-nary-view "generic/"))
                 (th (get-typechecked-theory (sal-transition-view-theory-name generic))))
            (sal-test (formals th) "generic N remains a PVS theory formal")
            (sal-test (not (sal-transition-view-instantiated-p generic))
                      "generic N is not silently instantiated")
            (sal-test (sal-transition-view-backend-admission-note generic)
                      "generic checker admission is explicitly deferred")
            (sal-test (find "check_step_1_TCC1" (sal-transition-view-tccs generic)
                            :key #'sal-source-obligation-name :test #'string=)
                      "indexed increment retains its source-level subtype TCC")
            (sal-show-obligations generic)
            (sal-nary-snapshot generic "generic"))
          (let* ((view (sal-nary-view "three/" :n 3))
                 (theory (sal-transition-view-theory-name view))
                 (key (format nil "~a.aligned" theory)))
            (sal-test (string= (sal-transition-view-selector view) "nary{3}!sync")
                      "concrete backend selector carries N = 3")
            (sal-test (null (formals (get-typechecked-theory theory)))
                      "concrete PVS machine theory is closed")
            (sal-nary-snapshot view "three")
            (sal-test-type-tccs view)
            (sal-test-prove theory "sal_aligned" `(then (sal-source) (sal-check ,key)))
            (sal-test (eq (sal-check-result-outcome *sal-last-check-result*) :proved)
                      "SAL proves the synchronous alignment invariant")
            (sal-print-check-result *sal-last-check-result*)
            (sal-nary-save-result view "three"))
          (let* ((view (sal-nary-view "async-three/" :n 3 :module "async"))
                 (theory (sal-transition-view-theory-name view)))
            (sal-nary-snapshot view "async-three")
            (sal-test-type-tccs view)
            (sal-test-prove theory "sal_async_x5F_aligned"
                            `(sal-check ,(format nil "~a.async_aligned" theory))
                            :expect-complete nil)
            (sal-test (eq (sal-check-result-outcome *sal-last-check-result*) :counterexample)
                      "asynchronous alignment fails and leaves its PVS goal open")
            (sal-print-check-result *sal-last-check-result*)
            (sal-nary-save-result view "async-three"))
          (format t "~&SAL-NARY-DEMO-PASSED~%")))
  (error (condition)
    (format t "~&SAL-NARY-FAILED: ~a~%" condition)))
