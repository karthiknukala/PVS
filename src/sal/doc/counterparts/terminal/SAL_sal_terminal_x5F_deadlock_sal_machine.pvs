% The relations below are exported by SAL's module normalizer.
SAL_sal_terminal_x5F_deadlock_sal_machine: THEORY
BEGIN

  IMPORTING SALCTX_sal_terminal_x5F_deadlock

  State: TYPE = [# sal_value: subrange(0, 2) #]

  s, next: VAR State

  defined(s: State): bool = TRUE

  initial(s: State): bool = defined(s) AND (((s)`sal_value = 0) AND TRUE)

  step(s, next: State): bool = defined(s) AND defined(next) AND (TRUE AND ((s)`sal_value < 2) AND ((next)`sal_value = ((s)`sal_value + 1)))

  idle(s, next: State): bool = defined(s) AND defined(next) AND ((next)`sal_value = (s)`sal_value)

  IMPORTING SAL_Transition_System[State, initial, step] AS system

  % Separate checks preserve nondeterministic branch typing.
  check_initial_1(s, next: State): bool =
    TRUE IMPLIES (LET bridge_rhs: subrange(0, 2) = 0 IN TRUE)

  check_step_1(s, next: State): bool =
    (TRUE AND ((s)`sal_value < 2)) IMPLIES (LET bridge_rhs: subrange(0, 2) = ((s)`sal_value + 1) IN TRUE)

  sal_bounded: THEOREM system.invariant(LAMBDA (s: State): ((s)`sal_value <= 2))

END SAL_sal_terminal_x5F_deadlock_sal_machine
