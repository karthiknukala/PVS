;;; Experimental presentation only. Never used for parsing, proof or admission.
(in-package :pvs)

(defvar *sal-syntax-mode* nil)
(defvar *sal-display-view* nil)
(defvar *sal-display-names* nil)
(defvar *sal-display-used-names* nil)
(defvar *sal-display-budget* 0)
(defvar *sal-display-state-binder* nil)
(declaim (ftype function sal-display-type sal-display-expr sal-display-invariant))

(defun sal-display-module ()
  (or (sal-transition-view-selector *sal-display-view*)
      (format nil "~a!~a" (sal-declaration-name (sal-transition-view-context *sal-display-view*))
              (sal-transition-view-module-name *sal-display-view*))))

(defun sal-display-local-state-name (name)
  (when (and *sal-display-view* (resolution name)
             (eq (module (declaration name))
                 (get-typechecked-theory (sal-transition-view-theory-name *sal-display-view*)))
             (null (actuals (module-instance name))))
    (cdr (assoc (string (id name))
                '(("State" . "STATE_TYPE") ("initial" . "INIT_PRED") ("step" . "TRANS_PRED"))
                :test #'string=))))

(defun sal-set-syntax-mode (enabled)
  (setf *sal-syntax-mode* (not (null enabled))))

(defun sal-display-source-id (id)
  "Invert our injective identifier encoding, only when it round trips."
  (let* ((text (string id))
         (start (cond ((uiop:string-prefix-p "sal_" text) 0)
                      ((uiop:string-prefix-p "bridge_local_" text)
                       (search "sal_" text)))))
    (when start
      (handler-case
          (let* ((encoded (subseq text start))
                 (decoded
                   (with-output-to-string (out)
                     (loop for i from 4 below (length encoded) do
                       (if (char= (char encoded i) #\_)
                           (let ((end (position #\_ encoded :start (+ i 2))))
                             (unless (and end (char-equal (char encoded (1+ i)) #\x))
                               (error "Not an encoded identifier"))
                             (write-char (code-char (parse-integer encoded :start (+ i 2)
                                                                 :end end :radix 16)) out)
                             (setf i end))
                           (write-char (char encoded i) out))))))
            (when (string-equal (sal-pvs-name decoded) encoded) decoded))
        (error () nil)))))

(defun sal-display-id (id)
  (or (sal-display-source-id id)
      (let ((s (string id)))
        (if (and (plusp (length s))
                 (alpha-char-p (char s 0))
                 (every (lambda (c) (or (alphanumericp c) (char= c #\_))) s))
            s (sal-pvs2sal-identifier s)))))

(defun sal-display-bound-name (decl)
  (or (gethash decl *sal-display-names*)
      (let* ((base (sal-display-id (id decl))) (name base))
        (loop for n from 2 while (gethash name *sal-display-used-names*) do
          (setf name (format nil "~a_~d" base n)))
        (setf (gethash name *sal-display-used-names*) t
              (gethash decl *sal-display-names*) name))))

(defun sal-display-view-for-declaration (decl)
  "Recognize the actual generated file, not merely a coincident theory name."
  (when (and (declaration? decl) (module decl))
    (let ((source (ignore-errors (sal-theory-source-file (module decl)))))
      (when source
        (loop for view being the hash-values of *sal-transition-views*
              when (some (lambda (file)
                           (and file (equal (probe-file file) (probe-file source))))
                         (append (list (sal-transition-view-pvs-file view)
                                       (sal-transition-view-progress-pvs-file view)
                                       (sal-transition-view-causality-pvs-file view))
                                 (sal-transition-view-context-pvs-files view)))
              return view)))))

(defun sal-display-name (name)
  (let* ((decl (and (resolution name) (declaration name)))
         (instance (and (resolution name) (module-instance name)))
         (bound (and decl (or (binding? decl) (skolem-const-decl? decl)))))
    (cond ((and *sal-display-state-binder* (eq decl *sal-display-state-binder*))
           (error "State occurs outside a field projection"))
          ((sal-display-local-state-name name)
           (format nil "~a(~a)" (sal-display-local-state-name name) (sal-display-module)))
          (bound (sal-display-bound-name decl))
          ((member (sal-pvs2sal-builtin name) '("TRUE" "FALSE") :test #'equal)
           (sal-pvs2sal-builtin name))
          (t
           (when (and instance (or (mappings instance) (dactuals instance)))
             (error "PVS theory mapping has no SAL display form"))
           (let* ((owner (and decl (module decl)))
                  (owner-id (and owner (string (id owner))))
                  (ctx (and owner-id (uiop:string-prefix-p "SALCTX_" owner-id)
                            (sal-display-source-id (subseq owner-id 7))))
                  (actuals (and instance (actuals instance))))
             (format nil "~a~a"
                     (if (or ctx (and instance (id instance)))
                         (format nil "~a~a!"
                                 (or ctx (sal-display-id (id instance)))
                                 (if actuals
                                     (format nil "{~{~a~^, ~}}"
                                             (mapcar (lambda (a)
                                                       (let ((v (actual-value a)))
                                                         (if (type-expr? v) (sal-display-type v)
                                                             (sal-display-expr v)))) actuals)) "")) "")
                     (sal-display-id (id name))))))))

(defun sal-display-type (ty)
  (when (minusp (decf *sal-display-budget*)) (error "SAL display size limit"))
  (cond ((tc-eq ty *boolean*) "BOOLEAN")
        ((tc-eq ty *integer*) "INTEGER")
        ((tc-eq ty *naturalnumber*) "NATURAL")
        ((tc-eq ty *real*) "REAL")
        ((and (print-type ty) (not (eq (print-type ty) ty)))
         (sal-display-type (print-type ty)))
        ((type-name? ty)
         (if (and (resolution ty) (sal-pvs2sal-original-prelude-p (declaration ty))
                  (string= (string (id ty)) "subrange")
                  (= (length (actuals ty)) 2))
             (format nil "[~a..~a]" (sal-display-expr (actual-value (first (actuals ty))))
                     (sal-display-expr (actual-value (second (actuals ty)))))
             (sal-display-name ty)))
        ((subtype? ty)
         (let ((pred (predicate ty)))
           (unless (and (lambda-expr? pred) (= (length (bindings pred)) 1))
             (error "Non-lambda PVS subtype predicate"))
           (format nil "{~a: ~a | ~a}"
                   (sal-display-bound-name (first (bindings pred)))
                   (sal-display-type (supertype ty))
                   (sal-display-expr (expression pred)))))
        ((recordtype? ty)
         (format nil "[# ~{~a~^, ~} #]"
                 (mapcar (lambda (f) (format nil "~a: ~a" (sal-display-id (id f))
                                            (sal-display-type (type f)))) (fields ty))))
        ((tupletype? ty)
         (format nil "[~{~a~^, ~}]" (mapcar #'sal-display-type (types ty))))
        ((funtype? ty)
         (when (dep-binding? (domain ty)) (error "Dependent PVS function type"))
         (format nil "[~a -> ~a]" (sal-display-type (domain ty)) (sal-display-type (range ty))))
        (t (error "Unsupported PVS type ~a" (type-of ty)))))

(defun sal-display-field-call (op vals)
  ;; Arrays and functions share a PVS representation but have different SAL
  ;; syntax. Use source types only for a verified projection of this view's State.
  (let* ((ty (type (argument op)))
         (name (if (and (type-expr? ty) (print-type ty)) (print-type ty) ty))
         (state (and (type-name? name)
                     (equal (sal-display-local-state-name name) "STATE_TYPE")))
         (field (and state
                     (find (string (id op))
                           (state-vars (sal-transition-view-flat-module *sal-display-view*))
                           :key (lambda (v) (sal-pvs-name (sal-declaration-name v))) :test #'equal)))
         (source-type (and field (sal-pvs-unalias-type (type field)))))
    (cond ((typep source-type 'sal-array-type)
           (unless (= (length vals) 1) (error "SAL array selection arity"))
           (format nil "(~a)[~a]" (sal-display-expr op) (first vals)))
          ((typep source-type 'sal-function-type)
           (format nil "(~a)(~{~a~^, ~})" (sal-display-expr op) vals))
          (t (error "Function/array projection lacks an unambiguous SAL source type")))))

(defun sal-display-expr (ex)
  (when (minusp (decf *sal-display-budget*)) (error "SAL display size limit"))
  (cond
    ((string-expr? ex) (error "PVS strings require a SAL representation adapter"))
    ((rational-expr? ex) (format nil "~a" (number ex)))
    ((name-expr? ex) (sal-display-name ex))
    ((field-application? ex)
     (if (and *sal-display-state-binder* (name-expr? (argument ex))
              (eq (declaration (argument ex)) *sal-display-state-binder*))
         (sal-display-id (id ex))
         (format nil (if (name-expr? (argument ex))
                         "~a.~a" "(~a).~a")
                 (sal-display-expr (argument ex)) (sal-display-id (id ex)))))
    ((projection-application? ex)
     (format nil "(~a).~d" (sal-display-expr (argument ex)) (index ex)))
    ((application? ex)
     (let ((invariant (sal-display-invariant ex)))
       (when invariant (return-from sal-display-expr invariant)))
     (let* ((op (operator ex)) (builtin (sal-pvs2sal-builtin op))
            (args (sal-pvs2sal-arguments ex))
            (vals (mapcar #'sal-display-expr args)))
       (cond ((and (equal builtin "IF") (= (length vals) 3))
              (format nil "(IF ~a THEN ~a ELSE ~a ENDIF)" (first vals) (second vals) (third vals)))
             ((and (member builtin '("NOT" "-") :test #'equal) (= (length vals) 1))
              (format nil "(~a ~a)" builtin (first vals)))
             ((and builtin (= (length vals) 2))
              (format nil "(~a ~a ~a)" (if (equal builtin "WHEN") (second vals) (first vals))
                      (cond ((equal builtin "IMPLIES") "=>") ((equal builtin "IFF") "<=>")
                            ((equal builtin "WHEN") "=>") (t builtin))
                      (if (equal builtin "WHEN") (first vals) (second vals))))
             ((field-application? op) (sal-display-field-call op vals))
             (t (format nil "(~a)(~{~a~^, ~})" (sal-display-expr op) vals)))))
    ((tuple-expr? ex) (format nil "(~{~a~^, ~})" (mapcar #'sal-display-expr (exprs ex))))
    ((update-expr? ex)
     ;; SAL has one update per WITH; do not silently serialize parallel PVS updates.
     (unless (= (length (assignments ex)) 1) (error "Parallel PVS update"))
     (let ((base (find-supertype (type (expression ex)))))
       (format nil "(~a WITH ~{~a~^, ~})" (sal-display-expr (expression ex))
               (mapcar (lambda (a)
                         (let ((args (arguments a)))
                           (unless (and (= (length args) 1) (= (length (car args)) 1))
                             (error "Nested PVS update"))
                           (format nil "~a := ~a"
                                   (cond ((recordtype? base)
                                          (format nil ".~a" (sal-display-id (id (caar args)))))
                                         ((funtype? base)
                                          (error "Function/array update requires a SAL representation adapter"))
                                         (t (error "Unsupported update carrier")))
                                   (sal-display-expr (expression a))))) (assignments ex)))))
    ((record-expr? ex)
     (format nil "(# ~{~a~^, ~} #)"
             (mapcar (lambda (a)
                       (let ((args (arguments a)))
                         (unless (and (= (length args) 1) (= (length (car args)) 1)
                                      (name-expr? (caar args))) (error "Record assignment shape"))
                         (format nil "~a := ~a" (sal-display-id (id (caar args)))
                                 (sal-display-expr (expression a))))) (assignments ex))))
    ((or (forall-expr? ex) (exists-expr? ex) (lambda-expr? ex))
     (let ((decls (mapcar (lambda (b) (format nil "~a: ~a" (sal-display-bound-name b)
                                            (sal-display-type (type b)))) (bindings ex))))
       (format nil "(~a (~{~a~^, ~}): ~a)"
               (cond ((forall-expr? ex) "FORALL") ((exists-expr? ex) "EXISTS") (t "LAMBDA"))
               decls (sal-display-expr (expression ex)))))
    (t (error "Unsupported PVS expression ~a" (type-of ex)))))

(defun sal-display-invariant (ex)
  "Recognize the exact shared-view instance, including its actual definitions."
  (let* ((op (operator ex)) (pred (argument ex))
         (actuals (and (name-expr? op) (resolution op) (actuals (module-instance op)))))
    (when (and *sal-display-view* (name-expr? op) (resolution op)
               (sal-pvs-canonical-invariant-p (declaration op))
               (= (length actuals) 3) (lambda-expr? pred) (= (length (bindings pred)) 1)
               (every (lambda (a expected)
                        (let* ((raw (actual-value a))
                               (v (if (and (type-expr? raw) (print-type raw)) (print-type raw) raw)))
                          (and (typep v '(or type-name name-expr))
                               (equal (sal-display-local-state-name v) expected))))
                      actuals '("STATE_TYPE" "INIT_PRED" "TRANS_PRED")))
      (handler-case
          (let ((*sal-display-state-binder* (first (bindings pred))))
            (dolist (v (state-vars (sal-transition-view-flat-module *sal-display-view*)))
              (setf (gethash (sal-declaration-name v) *sal-display-used-names*) t))
            (format nil "(~a |- G(~a))" (sal-display-module)
                    (sal-display-expr (expression pred))))
        (error () nil)))))

(defun sal-display-formula (formula view)
  "Render the current AST. Unsupported constructs keep the whole PVS formula."
  (let ((*sal-display-view* view)
        (*sal-display-names* (or *sal-display-names* (make-hash-table :test #'eq)))
        (*sal-display-used-names* (or *sal-display-used-names* (make-hash-table :test #'equal)))
        (*sal-display-budget* 10000))
    (handler-case (sal-display-expr formula)
      (error (e) (format nil "[PVS fallback: ~a]~%~a" e (str formula))))))

(defun sal-display-tcc-formula (formula view)
  "Pretty-print the actual formula, retaining every binder and connective.
Only layout and redundant outer grouping change; no logical simplification."
  (let ((*sal-display-view* view)
        (*sal-display-names* (make-hash-table :test #'eq))
        (*sal-display-used-names* (make-hash-table :test #'equal))
        (*sal-display-budget* 10000)
        (*print-pretty* t) (*print-right-margin* 78))
    (handler-case
        (with-output-to-string (out)
          (labels ((show (ex stream &optional grouped)
                     (when (minusp (decf *sal-display-budget*))
                       (error "SAL display size limit"))
                     (let* ((op (and (application? ex) (sal-pvs2sal-builtin (operator ex))))
                            (args (and op (sal-pvs2sal-arguments ex))))
                       (cond
                         ((or (forall-expr? ex) (exists-expr? ex) (lambda-expr? ex))
                          (pprint-logical-block (stream nil :prefix (if grouped "(" "")
                                                           :suffix (if grouped ")" ""))
                            (write-string (cond ((forall-expr? ex) "FORALL (")
                                                ((exists-expr? ex) "EXISTS (")
                                                (t "LAMBDA (")) stream)
                            (pprint-logical-block (stream (bindings ex) :suffix "):")
                              (loop
                                (let ((b (pprint-pop)))
                                  (format stream "~a: ~a" (sal-display-bound-name b)
                                          (sal-display-type (type b))))
                                (pprint-exit-if-list-exhausted)
                                (write-string ", " stream)
                                (pprint-newline :fill stream)))
                            (pprint-indent :block 2 stream)
                            (pprint-newline :mandatory stream)
                            (show (expression ex) stream)))
                         ((and (= (length args) 2)
                               (member op '("AND" "OR" "IMPLIES" "IFF" "WHEN") :test #'equal))
                          (pprint-logical-block (stream nil :prefix (if grouped "(" "")
                                                           :suffix (if grouped ")" ""))
                            (show (if (equal op "WHEN") (second args) (first args)) stream t)
                            (write-char #\Space stream)
                            (pprint-indent :block 2 stream)
                            (pprint-newline (if (member op '("IMPLIES" "WHEN") :test #'equal)
                                               :mandatory :linear) stream)
                            (format stream "~a " (cond ((member op '("IMPLIES" "WHEN") :test #'equal) "=>")
                                                       ((equal op "IFF") "<=>") (t op)))
                            (show (if (equal op "WHEN") (first args) (second args)) stream t)))
                         (t
                          (let ((text (sal-display-expr ex)))
                            ;; Atomic operands of logical connectives need no outer
                            ;; parentheses. Keep grouping inside arithmetic, updates,
                            ;; tuples, records and conditionals exactly as rendered.
                            (write-string
                             (if (and op (= (length args) 2)
                                      (> (length text) 2) (char= (char text 0) #\()
                                      (char= (char text (1- (length text))) #\)))
                                 (subseq text 1 (1- (length text))) text) stream)))))))
            (show formula out)))
      (error () (sal-display-formula formula view)))))

(defun sal-display-write-formula (text stream)
  (if (uiop:string-prefix-p "[PVS fallback:" text) (write-string text stream)
      (let ((*print-right-margin* (or *prover-print-right-margin* *default-char-width*)))
        (pprint-logical-block (stream (uiop:split-string text :separator '(#\Space #\Newline)))
          (loop (write-string (pprint-pop) stream)
                (pprint-exit-if-list-exhausted)
                (write-char #\Space stream)
                (pprint-newline :fill stream))))))

;; Only this optional around method changes the prover's presentation. Native
;; ASTs, parser, commands, proof rules, saved scripts and admission are untouched.
(defmethod print-object :around ((seq sequent) stream)
  (let ((view (and *sal-syntax-mode* (not *debugging-print-object*)
                   *top-proofstate*
                   (sal-display-view-for-declaration (declaration *top-proofstate*)))))
    (if (null view) (call-next-method)
        (let ((*sal-display-names* (make-hash-table :test #'eq))
              (*sal-display-used-names* (make-hash-table :test #'equal)))
          (labels ((show (sf n)
                     (let ((old (and *print-ancestor*
                                     (member sf (s-forms (current-goal *print-ancestor*)))))
                           (text (sal-display-formula (seq-formula sf) view)))
                       (format stream "~&~a~c~d~@[, ~{~a~^, ~}~]~c  "
                               (if (uiop:string-prefix-p "[PVS fallback:" text) "" "SAL/")
                               (if old #\[ #\{) n (label sf) (if old #\] #\}))
                       (sal-display-write-formula text stream)
                       (terpri stream))))
            (loop for sf in (neg-s-forms seq) for n downfrom -1 do (show sf n))
            (format stream "  |-------~%")
            (loop for sf in (pos-s-forms seq) for n from 1 do (show sf n)))
          (maphash (lambda (decl printed)
                     (unless (string= printed (string (id decl)))
                       (format stream "  [name ~a = PVS ~a]~%" printed (id decl))))
                   *sal-display-names*)
          seq))))

(addrule 'sal-syntax () ((enabled :toggle))
  (lambda (ps)
    (sal-set-syntax-mode (if (eq enabled :toggle) (not *sal-syntax-mode*) enabled))
    (commentary "SAL-origin display: ~a~%~a" (if *sal-syntax-mode* "SAL" "PVS") (current-goal ps))
    (values 'X nil nil))
  "Toggle experimental SAL display, or set it with (sal-syntax t)/(sal-syntax nil).
Presentation only; commands and expression arguments remain PVS."
  "Changing SAL presentation")

(export '(sal-set-syntax-mode *sal-syntax-mode* sal-display-formula))
