(in-package :pvs)
(let ((root (uiop:ensure-directory-pathname (uiop:getenv "SAL_BRIDGE_DIR"))))
  (load (merge-pathnames "load.lisp" root))
  (load (merge-pathnames "tests/support.lisp" root))
  (load (merge-pathnames "tests/structural-regressions.lisp" root)))
(setq *noninteractive* t *noninteractive-timeout* 60 *proceed-without-asking* t
      *proof-prompt-behavior* :noquestions *quit-prompt-behavior* :noquestions)

(defun sal-modular-test-open (source module &rest options)
  ;; Exercise the real native exporter, while making a flat fallback an error.
  (let ((flat (symbol-function 'sal-elaborate-view))
        (exporter (symbol-function 'sal-export-call)))
    (unwind-protect
        (progn
          (setf (symbol-function 'sal-elaborate-view)
                (lambda (&rest args) (declare (ignore args)) (error "Flat fallback invoked"))
                (symbol-function 'sal-export-call)
                (lambda (path target &optional selector)
                  (unless (member target '("--modular" "--manifest") :test #'equal)
                    (error "Flat export invoked: ~a" target))
                  (funcall exporter path target selector)))
          (apply #'sal-open source module :translation :modular options))
      (setf (symbol-function 'sal-elaborate-view) flat
            (symbol-function 'sal-export-call) exporter))))

(defun sal-modular-test-run ()
  (let ((root (uiop:ensure-directory-pathname (uiop:getenv "SAL_BRIDGE_TEST_OUTPUT"))))
    (dolist (case '(("counter" "bounded") ("open_component" "latch")
                    ("open_component" "connected") ("open_component" "interleaved")
                    ("nary" "sync") ("nary" "async")))
      (when (or (not (uiop:getenv "SAL_MODULAR_CASE")) (equal (second case) (uiop:getenv "SAL_MODULAR_CASE")))
      (destructuring-bind (file module) case
        (let* ((directory (merge-pathnames (format nil "~a-~a/" file module) root))
               (source (merge-pathnames (format nil "examples/modular/~a.sal" file) *sal-bridge-directory*))
               (modular (sal-modular-test-open source module :output-directory directory
                                  :register nil))
               (flat (sal-open source module :translation :flat :output-directory directory
                               :register nil :progress-checks nil))
               (comparison (sal-write-modular-comparison modular flat directory)))
          (sal-test (null (sal-transition-view-flat-module modular)) "modular view contains no flattened module")
          (sal-test (not (equal (sal-view-key modular) (sal-view-key flat))) "flat and modular views coexist")
          (sal-test (sal-transition-view-source-module modular) "module hierarchy retained")
          (sal-test (not (search "bridge_local" (sal-transition-view-pvs-text modular))) "readable native PVS names")
          (typecheck-file (pathname-name comparison) nil nil nil)
          (sal-test-type-tccs modular)
          (sal-test-type-tccs flat)
          (dolist (tcc (collect-tccs (get-typechecked-theory (pathname-name comparison))))
            (sal-test-prove (pathname-name comparison) (string (id tcc))
                            (if (equal file "counter")
                                '(then (skosimp*) (typepred "s!1`count") (grind))
                                '(grind))))
          (dolist (relation '("defined" "initial" "step" "idle"))
            (sal-test-prove (pathname-name comparison) (concatenate 'string relation "_equivalent") (if (and (equal module "async") (equal relation "step"))
                '(branch (grind :if-match nil)
                   ((then (inst + "i!1") (grind :if-match nil) (inst - "bridge_local_5_sal_i_x5F!1") (grind))
                    (then (inst + "i!1") (grind :if-match nil) (inst - "bridge_local_5_sal_i_x5F!1") (grind))
                    (then (inst + "bridge_local_4_sal_i_x5F!1") (grind :if-match nil) (inst - "j!1") (grind))
                    (then (inst + "bridge_local_4_sal_i_x5F!1") (grind :if-match nil) (inst - "j!1") (grind))))
                '(grind))))
          (when (equal file "counter")
            (sal-test (some (lambda (o) (search "increment_value" (sal-source-obligation-name o)))
                            (sal-transition-view-tccs modular)) "native TCC on named guarded increment")
            (typecheck-file "SAL_Guarded_Action")
            (dolist (tcc (collect-tccs (get-typechecked-theory "SAL_Guarded_Action")))
              (sal-test-prove "SAL_Guarded_Action" (string (id tcc)) '(grind)))
            (let* ((*sal-syntax-mode* t)
                   (data (sal-editor-description modular)))
              (sal-test (eq (getf data :translation) :modular) "editor identifies modular view")
              (sal-test (equal (getf (first (getf data :formulas)) :name) "within_limit")
                        "editor selects the readable theorem")
              (sal-test (some (lambda (entry) (and (search "increment_value" (getf entry :name))
                                                   (getf entry :source-expression)
                                                   (> (getf entry :line) 1)))
                              (getf data :tccs)) "editor TCC retains SAL assignment and source link"))
            (sal-typecheck-view modular :progress-checks nil)
            (sal-test-prove (sal-transition-view-theory-name modular) "within_limit"
                            '(sal-check "counter__bounded.within_limit")))))))
    (dolist (case '(("modular/quantified" "machine")
                    ("parameters/parameter_machine" "cell")
                    ("modular/nary_demo" "sync")
                    ("integration/frontend_choice_guards" "safe")))
      (destructuring-bind (file module) case
        (let* ((source (merge-pathnames (format nil "examples/~a.sal" file) *sal-bridge-directory*))
               (view (sal-modular-test-open source module :register nil
                       :output-directory (merge-pathnames (format nil "extra-~a/" (pathname-name source)) root))))
          (sal-test (null (sal-transition-view-flat-module view)) "supplemental example stays modular")
          (sal-test-type-tccs view)
          (when (equal file "modular/nary_demo")
            (sal-typecheck-view view :progress-checks nil)
            (sal-test-prove (sal-transition-view-theory-name view) "aligned"
                            '(sal-check "nary_demo__sync.aligned")))
          (when (equal file "integration/frontend_choice_guards")
            (sal-test (some (lambda (o) (and (search "partial_enabled" (sal-source-obligation-name o))
                                           (sal-source-obligation-place o)))
                           (sal-transition-view-tccs view))
                      "partial guard retains its own source-linked domain TCC")))))
    (let ((bad (sal-open (merge-pathnames "examples/modular/bad_counter.sal" *sal-bridge-directory*)
                         "bounded" :translation :modular :progress-checks nil :register nil
                         :output-directory (merge-pathnames "bad/" root))))
      (sal-test (some (lambda (o) (and (search "overflow_value" (sal-source-obligation-name o))
                                     (sal-source-place-p (sal-source-obligation-place o))))
                     (sal-transition-view-tccs bad)) "overlapping valid branch cannot hide overflow TCC")
      (let ((overflow (find-if (lambda (o) (search "overflow_value" (sal-source-obligation-name o)))
                               (sal-transition-view-tccs bad))))
        (sal-test-prove (sal-transition-view-theory-name bad)
                        (sal-source-obligation-name overflow) '(grind) :expect-complete nil)))
    (unless (uiop:getenv "SAL_MODULAR_CASE")
      (sal-selection-typing-regressions root)
      (sal-structural-regressions root))
    (format t "~%SAL-MODULAR-TESTS-PASSED (~d assertions)~%" *sal-test-count*)))
(handler-case (sal-modular-test-run)
  (error (e) (when *sal-last-check-result* (sal-print-check-result)) (format t "~%SAL-MODULAR-FAILED: ~a~%" e) (uiop:quit 1)))
(uiop:quit)
