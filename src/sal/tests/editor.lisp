(in-package :pvs)
;; Capture an instance and compile an accessor before loading the bridge. The
;; kn-pvs image contains the original four-coordinate structure already.
(defparameter *sal-editor-old-place*
  (when (fboundp 'make-sal-source-place) (make-sal-source-place 2 3 5 7)))
(defparameter *sal-editor-old-place-reader*
  (when *sal-editor-old-place*
    (compile nil '(lambda (p) (list (sal-source-place-initial-line p)
                                    (sal-source-place-initial-column p)
                                    (sal-source-place-final-line p)
                                    (sal-source-place-final-column p))))))
(let ((root (uiop:ensure-directory-pathname (uiop:getenv "SAL_BRIDGE_DIR"))))
  (load (merge-pathnames "load.lisp" root))
  (load (merge-pathnames "tests/support.lisp" root)))
(setq *proof-prompt-behavior* :noquestions *proceed-without-asking* t
      *noninteractive* t *noninteractive-timeout* 60)

(defun sal-editor-test-run ()
  (when *sal-editor-old-place*
    (sal-test (equal (funcall *sal-editor-old-place-reader* *sal-editor-old-place*) '(2 3 5 7))
              "preloaded source-place instance and compiled accessors survive bridge load"))
  (let* ((xml (sal-view-read-xml "<NODE PLACE='11 2 12 4' SOURCEFILE='/import.sal'/>"))
         (place (sal-source-place-from-xml xml)))
    (load (merge-pathnames "xml-reader.lisp" *sal-bridge-directory*))
    (sal-test (and (sal-source-place-p place)
                   (= (sal-source-place-initial-line place) 11)
                   (equal (sal-source-place-source-file place) "/import.sal")
                   (equal (sal-source-place-source-file (copy-structure place)) "/import.sal"))
              "source provenance subtype survives reader reload and copying")
    (when *sal-editor-old-place-reader*
      (sal-test (equal (funcall *sal-editor-old-place-reader* place) '(11 2 12 4))
                "preloaded compiled accessors accept new source provenance subtype")))
  (let* ((out (uiop:ensure-directory-pathname (uiop:getenv "SAL_BRIDGE_TEST_OUTPUT")))
         (source (merge-pathnames "examples/bounded_counter.sal" *sal-bridge-directory*))
         (view (sal-open source "counter" :output-directory (merge-pathnames "counter/" out)
                         :progress-checks nil))
         (th (get-typechecked-theory (sal-transition-view-theory-name view)))
         (decl (find-if (lambda (d) (and (formula-decl? d) (eq (id d) '|sal_bounded|))) (theory th)))
         (replay (equal (uiop:getenv "SAL_EDITOR_PHASE") "replay")))
    (sal-test (eql (getf *sal-last-wfc-result* :status) 0) "native sal-wfc ran")
    (sal-test (eq view (sal-display-view-for-declaration decl)) "display identifies generated declaration")
    (sal-set-syntax-mode t)
    (let* ((data (sal-editor-description view))
           (tcc (find "check_step_5_TCC1" (getf data :tccs) :key (lambda (x) (getf x :name)) :test #'equal))
           (text (getf tcc :text)))
      (sal-test (and text (search ".count" text) (search "STATE_TYPE(" text)
                     (not (search "sal_count" text)) (not (search "fallback" text)))
                "TCC renders SAL fields and native state type")
      (sal-test (and (search "FORALL (" text) (search "=>" text) (search "AND" text)
                     (search "s.phase = bounded_counter!counting" text)
                     (search "s.count < bounded_counter!LIMIT" text)
                     (search "0 <= (s.count + 1)" text)
                     (search "(s.count + 1) <= bounded_counter!LIMIT" text)
                     (search "next: STATE_TYPE(" text)
                     (find #\Newline text))
                "TCC formula retains binders, both guards and both requirements with line breaks")
      (sal-test (equal (getf tcc :source-expression) "count' = count + 1")
                "TCC includes the SAL assignment as source metadata")
      (sal-write-file-if-changed (merge-pathnames "formatted-tcc.txt" out) text)
      (sal-test (search "|- G(" (getf (first (getf data :formulas)) :text))
                "exact shared invariant renders as SAL theorem")
      (sal-test (= (getf (first (getf data :formulas)) :line) 41) "theorem source location")
      ;; Check the displayed SAL syntax with the real SAL parser/typechecker.
      (sal-write-file-if-changed (merge-pathnames "bounded_counter.sal" out) (uiop:read-file-string source))
      (let ((roundtrip (merge-pathnames "display_roundtrip.sal" out)))
        (sal-write-file-if-changed roundtrip
          (format nil "display_roundtrip: CONTEXT =~%BEGIN~% displayed_check: BOOLEAN = ~a;~%END~%" text))
        (sal-check-well-formed roundtrip)
        (sal-test t "printed TCC is accepted as SAL by native sal-wfc"))
      (sal-write-file-if-changed (merge-pathnames "display.txt" out)
                                (with-output-to-string (s) (sal-show-obligations view s))))
    (let ((formula (definition decl)))
      (sal-test (search "PVS fallback" (sal-display-formula (parse :string "\"hello\"" :nt 'expr) view))
                "unsupported AST is explicit PVS fallback")
      (sal-test (search "PVS fallback" (sal-display-tcc-formula (parse :string "\"hello\"" :nt 'expr) view))
                "unsupported TCC expression keeps the whole PVS formula")
      (sal-display-formula formula view)
      (sal-test (eq formula (definition decl)) "display does not replace native AST"))
    (if replay
        (dolist (tcc (collect-tccs th))
          (sal-test (justification tcc) "saved TCC proof exists")
          (sal-test (eq (status-flag (prove-decl tcc :strategy '(then (rerun) (quit)))) '!)
                    "SAL display proof replays"))
        (dolist (tcc (collect-tccs th))
          (sal-test-prove (string (id th)) (string (id tcc))
                          '(then (sal-syntax t) (skosimp*) (sal-syntax nil) (sal-syntax t) (grind)))))
    ;; The actual editor proof entry, not merely a detached scratch formula.
    (let ((*noninteractive* t) (*last-proof* nil)
          (*standard-input* (make-string-input-stream "(rerun) (quit)"))
          (*quit-prompt-behavior* :noquestions))
      (sal-editor-prove (sal-view-key view) (string (id th)) "check_step_5_TCC1" "SAL test buffer")
      (sal-test (and *last-proof*
                     (eq (id (declaration *last-proof*)) '|check_step_5_TCC1|))
                "editor starts the selected TCC, not the first formula in the file"))
    (let ((*noninteractive* t) (*last-proof* nil)
          (*standard-input* (make-string-input-stream "(quit)"))
          (*quit-prompt-behavior* :noquestions))
      (sal-editor-prove (sal-view-key view) (string (id th)) "sal_bounded" "SAL test buffer")
      (sal-test (and *last-proof* (eq (declaration *last-proof*) decl))
                "editor starts the exact source theorem"))
    (sal-test (proved? (find "check_step_5_TCC1" (collect-tccs th)
                            :key (lambda (d) (string (id d))) :test #'equal))
              "editor enters native saved TCC proof")
    (sal-test (handler-case
                  (progn (sal-editor-prove (sal-view-key view) (string (id th))
                                          "check_step_5_TCC1" "SAL test buffer" "obsolete-token") nil)
                (error () t)) "obsolete TCC button cannot select a new goal with the same name")
    (sal-set-syntax-mode nil)
    (sal-test (search "sal_count" (getf (find "check_step_5_TCC1"
                                             (getf (sal-editor-description view) :tccs)
                                             :key (lambda (x) (getf x :name)) :test #'equal) :text))
              "toggle off restores PVS TCC text")
    (let* ((bad (merge-pathnames "invalid.sal" out))
           (old (symbol-function 'sal-import-transition-view)) (exported nil) (message nil))
      (sal-write-file-if-changed bad "invalid: CONTEXT = BEGIN x: MissingType; END")
      (unwind-protect
          (progn
            (setf (symbol-function 'sal-import-transition-view)
                  (lambda (&rest args) (declare (ignore args)) (setf exported t) (error "Export reached")))
            (handler-case (sal-open bad "machine") (error (e) (setf message (format nil "~a" e)))))
        (setf (symbol-function 'sal-import-transition-view) old))
      (sal-test (and message (search "sal-wfc rejected" message) (not exported))
                "sal-wfc failure stops before translation"))
    (let* ((copy (merge-pathnames "freshness/bounded_counter.sal" out))
           (contents (uiop:read-file-string source)))
      (sal-write-file-if-changed copy contents)
      (let ((v (sal-open copy "counter" :output-directory (merge-pathnames "freshness/context/" out)
                         :progress-checks nil)))
        (sal-write-file-if-changed copy (concatenate 'string contents (format nil "~%%% edited~%")))
        (sal-test (handler-case (progn (sal-editor-view (sal-view-key v)) nil) (error () t))
                  "source edit rejects stale editor proof target")
        (sal-write-file-if-changed copy contents)))
    (sal-test (and (eq (sal-editor-view (sal-view-key view)) view)
                   (getf (sal-editor-description view) :formulas)) "switch back to another SAL context")
    (let ((calls (merge-pathnames "display_calls.sal" out)))
      (sal-write-file-if-changed calls
        (format nil "display_calls: CONTEXT =~%BEGIN~% Index: TYPE = [0..1];~% machine: MODULE =~% BEGIN~% OUTPUT a: ARRAY Index OF BOOLEAN~% OUTPUT f: [Index -> BOOLEAN]~% INITIALIZATION a = [[i: Index] TRUE]; f = LAMBDA(i: Index): TRUE~% TRANSITION [ TRUE --> a' = a; f' = f ]~% END;~% agreement: THEOREM machine |- G(a[0] = f(0));~%END~%"))
      (sal-set-syntax-mode t)
      (let* ((v (sal-open calls "machine" :output-directory (merge-pathnames "calls/" out)
                          :progress-checks nil :register nil))
             (text (getf (first (getf (sal-editor-description v) :formulas)) :text)))
        (sal-test (and (search "(a)[0]" text) (search "(f)(0)" text)
                       (not (search "fallback" text)))
                  "source types distinguish SAL array selection and function application")))
    (sal-editor-view (sal-view-key view))
    (let ((native (merge-pathnames "Native_Display.pvs" (uiop:pathname-directory-pathname
                                                         (sal-transition-view-pvs-file view)))))
      (sal-write-file-if-changed native
        (format nil "Native_Display: THEORY BEGIN~% IMPORTING SALCTX_sal_bounded_x5F_counter~% R: TYPE = [# left: int, right: int #]~% parallel: THEOREM FORALL(r:R): (r WITH [`left := 0, `right := 1])`left = 0~% shadow: THEOREM FORALL(sal_LIMIT:int): sal_LIMIT <= SALCTX_sal_bounded_x5F_counter.sal_LIMIT OR sal_LIMIT > SALCTX_sal_bounded_x5F_counter.sal_LIMIT~% reflexive: THEOREM FORALL(x:int): x=x END Native_Display~%"))
      (typecheck-file "Native_Display")
      (sal-set-syntax-mode t)
      (let* ((th (get-typechecked-theory "Native_Display"))
             (parallel (find '|parallel| (theory th) :key (lambda (d) (and (formula-decl? d) (id d))))))
        (sal-test (search "PVS fallback: Parallel PVS update"
                          (sal-display-formula (definition parallel) view))
                  "parallel update is explicit fallback, never serialized incorrectly"))
      (let* ((shadow (find '|shadow| (theory (get-typechecked-theory "Native_Display"))
                           :key (lambda (d) (and (formula-decl? d) (id d)))))
             (before (definition shadow))
             (text (sal-display-tcc-formula before view)))
        (sal-test (and (search "LIMIT: INTEGER" text) (search "bounded_counter!LIMIT" text)
                       (search "OR " text) (eq before (definition shadow)))
                  "TCC formatting preserves shadowing, disjunction and native AST"))
      (let ((printed (with-output-to-string (*standard-output*)
                       (sal-test-prove "Native_Display" "reflexive" '(grind)))))
        (sal-test (and (not (search "Experimental SAL syntax" printed))
                       (not (search "SAL/" printed))) "native PVS proof display is unaffected")))
    (format t "~&SAL-EDITOR-~a-PASSED (~d assertions)~%" (if replay "REPLAY" "TESTS") *sal-test-count*)))

(handler-case (sal-editor-test-run)
  (error (e) (format t "~&SAL-EDITOR-FAILED: ~a~%" e) (uiop:quit 1)))
(uiop:quit)
