(in-package :pvs)
(let ((root (uiop:ensure-directory-pathname (uiop:getenv "SAL_BRIDGE_DIR"))))
  (load (merge-pathnames "load.lisp" root))
  (load (merge-pathnames "tests/support.lisp" root))
  (load (merge-pathnames "tests/backend-tests.lisp" root))
  (load (merge-pathnames "tests/semantics-tests.lisp" root))
  (load (merge-pathnames "tests/frontend-semantics.lisp" root))
  (load (merge-pathnames "tests/elaboration-corners.lisp" root))
  (load (merge-pathnames "tests/adapter-tests.lisp" root)))
(setq *proof-prompt-behavior* :noquestions *proceed-without-asking* t
      *noninteractive* t *noninteractive-timeout* 60)
(handler-case
    (progn
      (sal-test (sal-test-backend-result-parser) "backend semantic output parser")
      (sal-run-backend-tests :live t)
      (sal-test-output-boundary)
      (dolist (case '(("bounded_counter" "counter") ("arbiter" "system")
                      ("integration/overlapping_subtype" "machine")
                      ("integration/terminal_deadlock" "machine")
                      ("integration/indexed_composition" "synchronous")
                      ("integration/indexed_composition" "asynchronous")
                      ("integration/record_array" "machine")
                      ("integration/predicate_subtype" "machine")
                      ("integration/nondeterministic_selection" "machine")
                      ("integration/partial_array_subtype" "machine")
                      ("integration/renaming_capture" "system")
                      ("integration/builtin_shadow" "machine")
                      ("integration/binder_shadowing" "machine")
                      ("integration/causality_good" "system" t)
                      ("integration/causality_cycle" "system" t)))
        (destructuring-bind (file module &optional causal) case
          (format t "~%TESTING ~a/~a~%" file module)
          (let ((view (sal-test-open file module :causality-checks causal)))
            (sal-test (probe-file (sal-transition-view-pvs-file view))
                      (format nil "import/elaborate/typecheck ~a/~a" file module))
            (sal-test-concrete-semantics view file)
            (when (string= file "integration/overlapping_subtype")
              (sal-test (find-if (lambda (o) (search "check_step" (sal-source-obligation-name o)))
                                (sal-transition-view-tccs view))
                        "overlapping overflow branch retains native assignment TCC")
              (sal-show-obligations view))
            (when causal
              (sal-show-obligations view)
              (sal-test-causal-contract view file)))))
      (dolist (case '(("bounded_counter" "counter" "bounded" t)
                      ("integration/false_safety" "machine" "stays_zero" nil)))
        (destructuring-bind (file module assertion success) case
          (let* ((view (sal-test-open file module))
                 (theory (sal-transition-view-theory-name view))
                 (key (format nil "~a.~a" theory assertion)))
            (when success
              (sal-test-prove theory (sal-pvs-name assertion) `(sal-check ,key)
                              :expect-complete nil))
            (sal-test-type-tccs view)
            (when success
              (sal-test-prove theory (sal-pvs-name assertion)
                              `(then (expand "system.invariant") (sal-check ,key))
                              :expect-complete nil))
            (sal-test-prove theory (sal-pvs-name assertion)
                            `(then (sal-source) (sal-check ,key))
                            :expect-complete success)
            (sal-test (eq (sal-check-result-outcome *sal-last-check-result*)
                          (if success :proved :counterexample))
                      (format nil "actual prover backend result ~a" assertion)))))
      (sal-test-library-adapter
       :directory (merge-pathnames "adapter/" (uiop:ensure-directory-pathname
                                                (uiop:getenv "SAL_BRIDGE_TEST_OUTPUT"))))
      (sal-test-frontend-semantics)
      (sal-test-elaboration-corners)
      (sal-test-nonterminating-source-tcc)
      (sal-test-let-block-semantics)
      (sal-test-unused-temporal-tccs)
      (sal-test-primitive-partial-assignments)
      (sal-test-nondeterministic-guard-checks)
      (format t "~%SAL-BRIDGE-TESTS-PASSED~%"))
  (error (condition)
    (format t "~%SAL-BRIDGE-TESTS-FAILED: ~a~%" condition)))
