(in-package :pvs)

(defvar *sal-test-count* 0)
(defun sal-test-open (file module &rest options)
  (apply #'sal-open
         (merge-pathnames (format nil "examples/~a.sal" file) *sal-bridge-directory*)
         module :output-directory
         (merge-pathnames (format nil "~a/~a/" (sal-pvs-name file) (sal-pvs-name module))
                          (uiop:ensure-directory-pathname (uiop:getenv "SAL_BRIDGE_TEST_OUTPUT")))
         options))
(defun sal-test (condition label)
  (unless condition (error "SAL bridge test failed: ~a" label))
  (incf *sal-test-count*)
  (format t "~&PASS ~a~%" label))

(defun sal-test-prove (theory name strategy &key (expect-complete t))
  (let* ((th (get-typechecked-theory theory))
         (decl (find-if (lambda (d) (and (formula-decl? d)
                                        (string= name (string (id d)))))
                        (append (assuming th) (theory th)))))
    (unless decl (error "Missing proof target ~a.~a" theory name))
    (read-strategies-files)
    (setf (justification decl) (revert-justification (list "" strategy)))
    (let* ((result (prove-decl decl :strategy '(then (rerun) (quit))))
           (complete (eq (status-flag result) '!)))
      (sal-test (eql complete expect-complete) (format nil "proof ~a.~a => ~a" theory name (status-flag result)))
      (when complete (save-all-proofs th t) (save-context nil t))
      complete)))

(defun sal-test-type-tccs (view)
  (let* ((th (get-typechecked-theory (sal-transition-view-theory-name view)))
         (imports (remove-duplicates (cons th (all-importings th)) :test #'eq)))
    (dolist (theory imports)
      (unless (from-prelude? theory)
        (dolist (tcc (collect-tccs theory))
          (sal-test-prove (string (id theory)) (string (id tcc)) '(grind)))))))
