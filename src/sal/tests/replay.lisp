(in-package :pvs)
(let ((root (uiop:ensure-directory-pathname (uiop:getenv "SAL_BRIDGE_DIR"))))
  (load (merge-pathnames "load.lisp" root))
  (load (merge-pathnames "tests/frontend-semantics.lisp" root))
  (load (merge-pathnames "tests/elaboration-corners.lisp" root))
  (load (merge-pathnames "tests/support.lisp" root)))
(setq *proof-prompt-behavior* :noquestions *proceed-without-asking* t
      *noninteractive* t *noninteractive-timeout* 60)
(handler-case
    (let* ((view (sal-test-open "bounded_counter" "counter"))
           (theory (sal-transition-view-theory-name view)))
      (prove-theory "SAL_Transition_System" t nil nil t)
      ;; Replay just the proved native checks and registered safety theorem;
      ;; the other LTL theorem and optional progress obligations remain open.
      (let ((th (get-typechecked-theory theory)))
        (dolist (d (append (collect-tccs th)
                          (list (find "sal_bounded" (theory th)
                                      :key (lambda (d) (if (formula-decl? d) (string (id d)) "")) :test #'string=))))
          (sal-test (justification d) (format nil "saved proof ~a" (id d)))
          (sal-test (eq (status-flag (prove-decl d :strategy '(then (rerun) (quit)))) '!)
                    (format nil "fresh replay ~a" (id d)))))
      (let* ((directory (merge-pathnames "adapter/" (uiop:ensure-directory-pathname
                                                    (uiop:getenv "SAL_BRIDGE_TEST_OUTPUT"))))
             (adapter-view
              (sal-open (merge-pathnames "examples/integration/library_counter.sal"
                                         *sal-bridge-directory*)
                        "machine" :output-directory directory :progress-checks nil)))
        (typecheck-file "PVS_Library_Adapter")
        (prove-theory "SAL_Transition_System" t nil nil t)
        (let ((th (get-typechecked-theory (sal-transition-view-theory-name adapter-view))))
          (dolist (d (append (collect-tccs th)
                            (list (find "sal_safe" (theory th)
                                        :key (lambda (d) (if (formula-decl? d) (string (id d)) "")) :test #'string=))))
            (sal-test (justification d) (format nil "saved adapter dependency ~a" (id d)))
            (sal-test (eq (status-flag (prove-decl d :strategy '(then (rerun) (quit)))) '!)
                      (format nil "fresh adapter dependency ~a" (id d)))))
        (dolist (name '("PVS_Counter_Library" "PVS_Library_Adapter"))
          (prove-theory name t nil nil t)
          (dolist (d (theory (get-typechecked-theory name)))
            (when (and (formula-decl? d) (not (axiom? d)))
              (sal-test (and (proved? d) (string= (pc-complete d) "complete"))
                        (format nil "fresh adapter replay ~a" (id d)))))))
      (sal-replay-frontend-semantics)
      (sal-replay-nondeterministic-guard-checks)
      (let* ((view (sal-test-open "integration/frontend_let_blocks" "system"
                                  :progress-checks nil :register nil)))
        (declare (ignore view))
        (typecheck-file "Frontend_Let_Block_Check")
        (let* ((th (get-typechecked-theory "Frontend_Let_Block_Check"))
               (decl (find "parity" (theory th)
                           :key (lambda (d) (if (formula-decl? d) (string (id d)) "")) :test #'string=)))
          (sal-test (and decl (justification decl)) "saved LET-block proof")
          (sal-test (eq (status-flag (prove-decl decl :strategy '(then (rerun) (quit)))) '!)
                    "fresh LET-block semantic replay")))
      (format t "~%SAL-BRIDGE-REPLAY-PASSED~%"))
  (error (condition)
    (format t "~%SAL-BRIDGE-REPLAY-FAILED: ~a~%" condition)))
