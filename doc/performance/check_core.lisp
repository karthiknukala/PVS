;;; Run in a disposable context with pvs -q -raw -L /path/to/check_core.lisp.
(in-package :pvs)

(let* ((text "pvsPerfMixed𝒳")
       (upper (string-upcase text)))
  (assert (not (find-symbol upper :pvs)))
  (assert (not (find-symbol upper :sbst)))
  (assert (string= (id (parse :nt 'expr :string text)) text))
  (assert (not (find-symbol upper :pvs)))
  (assert (not (find-symbol upper :sbst)))
  (assert (projection-expr? (parse :nt 'expr :string "proj_1"))))

(let ((*spare-mapobject-cache* nil) outer inner)
  (mapobject (lambda (x)
               (setf outer *mapobject-cache*)
               (mapobject (lambda (y) (declare (ignore y)) (setf inner *mapobject-cache*)) x))
             'shared)
  (assert (and inner outer (not (eq inner outer))))
  (assert (zerop (hash-table-count *spare-mapobject-cache*)))
  (catch 'exit (mapobject (lambda (x) (throw 'exit x)) 'early))
  (assert (zerop (hash-table-count *spare-mapobject-cache*))))

(let* ((shared (list "shared"))
       (data (list shared shared '(1 . 2) (loop for i below 20000 collect i))))
  (store-object-to-file data "probe.bin")
  (remove-store-object-caches)
  (let ((copy (fetch-object-from-file "probe.bin")))
    (assert (equal data copy))
    (assert (eq (first copy) (second copy)))
    (assert (not (find (first copy) *fetch-object-update-obj* :test #'eq)))
    (assert (not (find copy *fetch-object-table* :test #'eq))))
  (with-open-file (input "probe.bin" :element-type '(unsigned-byte 32))
    (with-open-file (out "swapped.bin" :direction :output :if-exists :supersede
                         :element-type '(unsigned-byte 32))
      (loop for word = (read-byte input nil) while word
            do (write-byte (reverse-endian word) out))))
  (assert (equal data (fetch-object-from-file "swapped.bin")))
  (with-open-file (out "truncated.bin" :direction :output :if-exists :supersede
                       :element-type '(unsigned-byte 32))
    (write-byte 1 out)
    (write-byte 4 out)
    (write-byte 0 out))
  (assert (handler-case (progn (fetch-object-from-file "truncated.bin") nil)
            (file-error () t))))

(dolist (a '(a |α| nil "xz" #\a))
  (dolist (b '(a |α| nil "xz" #\a))
    (assert (eql (alphalessp a b) (string< (string a) (string b))))))

(let* ((key (list :variable))
       (fn (expr-eval `(let* ((x ',key)) (lambda () x)))))
  (assert (eq key (funcall fn)))
  (assert (equal (multiple-value-list
                  (expr-eval '(let* ((x 1) (y (1+ x))) (values x y))))
                 '(1 2)))
  (assert (equal (expr-eval '(grind)) '(grind))))

(let ((nodes (loop repeat 65 collect (list :name)))
      (*xref-names-seen* nil) (*xref-types-seen* nil))
  (dolist (node nodes)
    (assert (not (xref-seen? node *xref-names-seen*)))
    (assert (xref-seen? node *xref-names-seen*))
    (assert (not (xref-seen? node *xref-types-seen*))))
  (let ((*xref-names-seen* nil))
    (assert (not (xref-seen? (first nodes) *xref-names-seen*))))
  (assert (xref-seen? (first nodes) *xref-names-seen*)))

(format t "~&CORE-CHECKS-PASSED~%")
(sb-ext:exit)
