+                   (gethash qid theories) theory))
+           (when (or (attachment-source-not-found (attachment-source attach))
+                     (not theory)
+                     (< (attachment-tc-time attach) (typecheck-time theory)))
+             (remhash key *pvsio-attachments*)))))
+     *pvsio-attachments*)))
 
 
