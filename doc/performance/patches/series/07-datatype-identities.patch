+;; Most identity maps are discarded by their parent selection. Save the
+;; spelling in the current unparse context and parse only maps used in terms.
+(defstruct (deferred-identity-fun (:constructor make-deferred-identity-fun (source)))
+  source)
+
+(defun defer-identity-fun (te)
+  (make-deferred-identity-fun
+   (unparse (mk-name-expr '|id| (list (mk-actual te))) :string t)))
+
+(defun materialize-adt-map (map)
+  (if (deferred-identity-fun-p map)
+      (pc-parse (deferred-identity-fun-source map) 'expr)
+      map))
+
+(defmethod identity-fun? ((expr deferred-identity-fun))
+  t)
+
+(defun apply-adt-maps (operator maps)
+  (mk-application* operator (mapcar #'materialize-adt-map maps)))
