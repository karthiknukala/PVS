(in-package :pvs)
(setq *noninteractive* t *proceed-without-asking* t
      *proof-prompt-behavior* :noquestions *noninteractive-timeout* 120)

(let ((target (uiop:getenv "BENCH_TARGET"))
      (proof (uiop:getenv "BENCH_PROOF"))
      (xref (equal (uiop:getenv "BENCH_XREF") "1")))
  (dolist (file (uiop:split-string (uiop:getenv "BENCH_PREPARE") :separator '(#\Space)))
    (unless (zerop (length file))
      (let ((ths (typecheck-file file)))
        (assert (and ths (every #'typechecked? ths))))))
  (sb-ext:gc :full t)
  (let ((start (get-internal-real-time)) (bytes (sb-ext:get-bytes-consed)))
    (cond (xref
           (let ((*xref-types-seen* nil) (*xref-names-seen* nil))
             (dolist (th (sort (loop for m being the hash-values of (current-pvs-theories)
                                     collect m) #'string< :key #'id))
               (let ((*current-context* (saved-context th)))
                 (dolist (decl (all-decls th))
                   (when (declaration? decl) (setf (refers-to decl) nil)))
                 (generate-xref th)))))
          ((plusp (length proof)) (prove-theory proof t nil nil nil))
          (t (let ((ths (typecheck-file target (not (equal (uiop:getenv "BENCH_RESTORE") "1")))))
               (assert (and ths (every #'typechecked? ths))))))
    (format t "~&BENCH ~,5F ~D ~D~%" (/ (- (get-internal-real-time) start)
      internal-time-units-per-second) (- (sb-ext:get-bytes-consed) bytes)
      (nth-value 3 (sb-unix:unix-getrusage 0))))
  (with-open-file (out "signature.txt" :direction :output :if-exists :supersede)
    (dolist (th (sort (loop for m being the hash-values of (current-pvs-theories)
                            collect m) #'string< :key #'id))
      (assert (typechecked? th))
      (format out "~A ~D~%" (id th) (length (all-decls th)))
      (let ((*current-context* (saved-context th)))
        (dolist (d (all-decls th))
          (when (and xref (declaration? d))
            (format out "~&XREF ~A ~S" (id d) (place d))
            (dolist (ref (refers-to d))
              (format out " ~S/~S/~S" (when (module ref) (id (module ref)))
                      (id ref) (place ref)))
            (terpri out))
          (when (tcc-decl? d)
            (format out "~A ~A~%" (id d) (unparse (definition d) :string t))))))
    (when (plusp (length proof))
      (dolist (d (provable-formulas (get-theory proof)))
        (assert (not (unproved? d)))
        (format out "PROOF ~A ~A~%" (id d) (proof-status d))))))
(format t "~&CHECKED~%")
(sb-ext:exit)
