;;; Agent-only views over native proof objects. No separate proof engine.
(in-package :pvs)
(defvar *agent-last-responses* (make-hash-table :test #'equal))
(defvar *agent-preview-providers* (make-hash-table :test #'equal))

(defun agent-field (key row) (cdr (assoc key row :test #'equal)))
(defun agent-short (text &optional (limit 2000))
  (subseq text 0 (min limit (length text))))
(defun agent-root-proofstate (ps)
  (loop while (parent-proofstate ps) do (setf ps (parent-proofstate ps)) finally (return ps)))
(defun agent-goal-row (ps)
  `(("id" . ,(unique-ps-id ps)) ("label" . ,(label ps))
    ("parent" . ,(when (parent-proofstate ps) (unique-ps-id (parent-proofstate ps))))))
(defun agent-formula-rows (forms negative)
  (coerce (loop for sf in forms for i from 1
                for expr = (formula sf)
                collect `(("labels" . ,(coerce (cons (if negative (- i) i)
                                                    (mapcar #'symbol-name (label sf))) 'vector))
                          ("formula" . ,(str (if (negation? expr) (args1 expr) expr))))) 'vector))
(defun agent-compact-state (ps)
  (let* ((seq (current-goal ps))
         (goals (collect-all-remaining-subgoals (agent-root-proofstate ps))))
    (append (remove "id" (agent-goal-row ps) :key #'car :test #'equal)
            `(("proofstate_id" . ,(unique-ps-id ps))
              ("observer_id" . ,(when (fboundp 'agent-observer-id) (agent-observer-id ps)))
              ("open_goals" . ,(length goals))
              ("sequent" . (("antecedents" . ,(agent-formula-rows (neg-s-forms seq) t))
                             ("succedents" . ,(agent-formula-rows (pos-s-forms seq) nil))))
              ("hidden_counts" . (("antecedents" . ,(length (neg-s-forms* (hidden-s-forms seq))))
                                   ("succedents" . ,(length (pos-s-forms* (hidden-s-forms seq))))))))))
(defun agent-compact-response (response started)
  (let* ((id (agent-field "id" response)) (ps (agent-field "proofstate" response))
         (state (agent-session-state id)) (status (agent-native-proof-status state))
         (error (agent-field "error" response))
         (messages (remove-if (lambda (x) (typep x 'proofstate)) (agent-field "commentary" response)))
         (text (format nil "~{~a~%~}" messages))
         (base `(("compact" . t) ("id" . ,id) ("status" . ,status)
                 ("outcome" . ,(cond (error "command_error")
                                     ((agent-session-data-interrupted state) "interrupted")
                                     ((string= status "active") "open") (t status)))
                 ("recovery_note" . ,(agent-session-data-recovery-note state))
                 ("command_error" . ,error)
                 ("commentary" . ,(agent-short text 4000))
                 ("commentary_omitted_chars" . ,(max 0 (- (length text) 4000))))))
    (bt:with-lock-held (*agent-registry-lock*)
      (setf (gethash id *agent-last-responses*) response))
    ;; A render failure must never discard the authoritative proof outcome.
    (handler-case
        (setf base (append base
                           (if (string= status "active")
                               (agent-call-in-session id (lambda () (agent-compact-state ps)) (unique-ps-id ps))
                               (agent-compact-state ps))))
      (error (condition) (setf base (append base `(("render_error" . ,(princ-to-string condition)))))))
    (append base `(("elapsed_ms" . ,(* 1000.0 (/ (- (get-internal-real-time) started)
                                                 internal-time-units-per-second)))))))
(defun agent-full-response (id)
  (let ((response (bt:with-lock-held (*agent-registry-lock*) (gethash id *agent-last-responses*))))
    (unless response (error "No retained response for ~a" id))
    (if (string= (agent-native-proof-status (agent-session-state id)) "active")
        (agent-call-in-session id (lambda () (pvs-jsonrpc::pvs2json-response response))
                               (unique-ps-id (agent-field "proofstate" response)))
        (pvs-jsonrpc::pvs2json-response response))))
(defun agent-tree (id start limit)
  (agent-call-in-session
   id (lambda ()
        (let* ((ps (agent-current-proofstate))
               (goals (collect-all-remaining-subgoals (agent-root-proofstate ps)))
               (end (min (length goals) (+ start (max 1 (min limit 100))))))
          (unless (<= 0 start end) (error "Invalid tree offset"))
          `(("focus" . ,(agent-goal-row ps))
            ("ancestry" . ,(coerce (loop for node = ps then (parent-proofstate node)
                                         while node collect (agent-goal-row node)) 'vector))
            ("goals" . ,(coerce (mapcar #'agent-goal-row (subseq goals start end)) 'vector))
            ("next" . ,end) ("total" . ,(length goals)))))))
(defun agent-expression-children (expr)
  (cond ((application? expr) (list (operator expr) (argument expr)))
        ((tuple-expr? expr) (exprs expr))
        ((binding-expr? expr) (list (expression expr)))
        ((projection-application? expr) (list (argument expr)))
        (t nil)))
(defun agent-expression (id fnum path)
  (agent-call-in-session
   id (lambda ()
        (let* ((seq (current-goal (agent-current-proofstate)))
               (forms (if (minusp fnum) (neg-s-forms seq) (pos-s-forms seq)))
               (sf (and (not (zerop fnum)) (nth (1- (abs fnum)) forms))))
          (unless sf (error "No formula numbered ~a" fnum))
          (let* ((expr (formula sf)) (expr (if (minusp fnum) (args1 expr) expr)))
            (dolist (index (coerce path 'list))
              (let ((children (agent-expression-children expr)))
                (unless (< -1 index (length children)) (error "Invalid expression path"))
                (setf expr (nth index children))))
            `(("text" . ,(str expr)) ("type" . ,(when (type expr) (str (type expr))))
              ("class" . ,(string (class-name (class-of expr))))
              ("children" . ,(coerce (loop for child in (agent-expression-children expr) for i from 0
                                           collect `(("index" . ,i) ("text" . ,(agent-short (str child)))
                                                     ("type" . ,(when (type child) (str (type child)))))) 'vector))
              ("declaration" . ,(when (and (name-expr? expr) (declaration expr))
                                    (let ((decl (declaration expr)))
                                      `(("name" . ,(string (id decl)))
                                        ("theory" . ,(when (module decl) (string (id (module decl)))))
                                        ("instance" . ,(when (module-instance expr) (str (module-instance expr))))))))))))))
(defun agent-preview (id provider)
  (agent-call-in-session
   id (lambda ()
        (let ((function (gethash provider *agent-preview-providers*)))
          (unless function (error "No loaded preview provider ~s" provider))
          (multiple-value-bind (script output) (agent-capture-output function)
            (let (obligations lemmas)
              (labels ((walk (x)
                         (when (consp x)
                           (when (eq (car x) 'case) (push (second x) obligations))
                           (when (eq (car x) 'lemma) (push (second x) lemmas))
                           (mapc #'walk x))))
                (walk script))
              `(("script" . ,(let ((*print-case* :downcase) (*print-pretty* nil)) (prin1-to-string script)))
                ("obligations" . ,(coerce (nreverse obligations) 'vector))
                ("lemmas" . ,(coerce (remove-duplicates (nreverse lemmas) :test #'equal) 'vector))
                ("diagnostic" . ,output) ("trusted" . nil))))))))
(defun agent-evaluator-prepare (id expression)
  (let ((state (agent-require-session id :evaluator)))
    (when (or (agent-pvsio-meta-p expression) (agent-pvsio-quit-p expression))
      (error "Preparation requires a PVS expression"))
    (agent-check-prepared-sources)
    (agent-call-with-session-claim
     state (lambda ()
             (agent-call-with-setup
              (lambda ()
                (agent-dispatch state :prepare
                 (lambda ()
                   (let ((prepared (agent-prepare-and-cache-evaluation expression)))
                     `(("prepared" . ,(null (agent-evaluation-error prepared)))
                       ("type" . ,(when (agent-evaluation-type prepared) (str (agent-evaluation-type prepared))))
                       ("error" . ,(agent-evaluation-error prepared))
                       ("tccs" . ,(agent-evaluation-tcc-message prepared))
                       ("executed" . nil)))))))))))

(in-package :pvs-jsonrpc)
(defrequest agent-proof-open (formula rerun) "Open native proof with lazy metadata."
  (let ((started (get-internal-real-time)))
    (pvs::agent-compact-response (pvs::prover-init formula :rerun? rerun) started)))
(defrequest agent-proof-step (id command) "Execute native command with compact outcome."
  (let ((started (get-internal-real-time)))
    (pvs::agent-compact-response (pvs::prover-step id command) started)))
(defrequest agent-full (id) "Render the retained native response, including identifier metadata."
  (pvs::agent-full-response id))
(defrequest agent-tree (id start limit) "Page through native open leaves and focused ancestry."
  (pvs::agent-tree id start limit))
(defrequest agent-expression (id fnum path) "Inspect an existing typed expression; never reparse."
  (pvs::agent-expression id fnum path))
(defrequest agent-preview (id provider) "Generate an untrusted candidate script without executing it."
  (pvs::agent-preview id provider))
(defrequest agent-evaluator-prepare (id expression) "Prepare and cache without execution."
  (pvs::agent-evaluator-prepare id expression))

(in-package :pvs)
(defun agent-strategy-inventory ()
  (let (entries)
    (dolist (table (list *rules* *steps*))
      (maphash (lambda (name entry) (push (cons name entry) entries)) table))
    entries))
(agent-remember-original 'agent-load-strategy)
(defun agent-load-strategy (path)
  ;; Compare native registry entry identities. Defstep's $ expansion has its own
  ;; entry; source origins also expose strategies installed by nested LOADs.
  (agent-call-with-setup
   (lambda ()
    (let* ((before (agent-strategy-inventory))
         (result (funcall (agent-original 'agent-load-strategy) path))
         (changed (remove-if (lambda (pair) (eq (cdr pair) (cdr (assoc (car pair) before))))
                             (agent-strategy-inventory))))
    (append result
            `(("definitions" . ,(coerce (mapcar (lambda (pair)
                                                   (let ((source (get (car pair) :strategy-source-file)))
                                                     `(("name" . ,(string-downcase (car pair)))
                                                       ("source" . ,(when source (namestring source)))
                                                       ("fingerprint" . ,(when (and source (probe-file source))
                                                                           (agent-source-fingerprint source)))))) changed) 'vector))
              ("dependency_note" . "Origins cover strategy definitions. Helper-only LOAD dependencies are not inferred; keep the full source closure inside the prepared context for replay.")))))))

(in-package :pvs-jsonrpc)
(defrequest agent-obligations (theory-ref) "List existing declarations and TCC status in a prepared theory."
  (pvs::agent-call-with-setup
   (lambda ()
     (pvs::agent-check-prepared-sources)
     (multiple-value-bind (dir file name) (pvs::get-theory-ref theory-ref)
       (let ((theory (and name (pvs::get-theory (pvs::pc-parse name 'pvs::modname)))))
         (unless (and theory (pvs::typechecked? theory)
                      (or (null dir) (equal (truename dir) (truename (pvs::current-context-path))))
                      (or (null file) (equal (pathname-name (pathname file))
                                            (pathname-name (pathname (pvs::filename theory)))))
                      (assoc (namestring (truename (pvs::agent-theory-source-path theory)))
                             pvs::*agent-prepared-files* :test #'equal))
           (error "Theory is not in the prepared context; prepare it before inspection"))
         (coerce (mapcar (lambda (decl)
                           `(("name" . ,(string (pvs:id decl)))
                             ("tcc" . ,(not (null (pvs::tcc-decl? decl))))
                             ("status" . ,(pvs::proof-status decl))))
                         (pvs::all-formulas theory)) 'vector))))))
