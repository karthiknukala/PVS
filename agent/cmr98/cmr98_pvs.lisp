(in-package :pvs)
;;; Untrusted planner -> ordinary PVS commands. Never changes proof status,
;;; introduces axioms, calls an external solver, or uses TRUST.
(defun cmr98-width (expression)
  (let* ((ty (find-supertype (type expression)))
         (n (and (funtype? ty) (tc-eq (range ty) *boolean*)
                 (simple-below? (domain ty)))))
    (and n (number-expr? n) (integerp (number n))
         (plusp (number n)) (number n))))
(defun cmr98-origin-p (op name theory)
  (and (name-expr? op) (string= (string (id op)) name)
       (declaration op) (module (declaration op))
       (string= (string (id (module (declaration op)))) theory)))
(defun cmr98-ast (expression)
  (let ((n (cmr98-width expression)))
    (unless n (error "CMR requires a concrete positive bitvector width: ~a" expression))
    (cond
      ((cmr98-origin-p expression "bvec0" "bv") (list :const 0 n))
      ((cmr98-origin-p expression "bvec1" "bv") (list :const 1 n))
      ((name-expr? expression) (list :var (str expression) n))
      ((and (application? expression)
            (cmr98-origin-p (operator expression) "O" "bv_concat_def"))
       (list :cat (cmr98-ast (args1 expression)) (cmr98-ast (args2 expression))))
      ((and (application? expression)
            (cmr98-origin-p (operator expression) "^" "bv_caret"))
       (let ((bounds (exprs (args2 expression))))
         (unless (and (= (length bounds) 2) (every #'number-expr? bounds))
           (error "CMR requires numeral extraction bounds: ~a" expression))
         (list :cut (cmr98-ast (args1 expression))
               (number (first bounds)) (number (second bounds)))))
      (t (error "Outside the CMR composition/extraction fragment: ~a" expression)))))
(defun cmr98-render (term)
  (ecase (first term)
    (:var (second term))
    (:const (format nil "bvec~d[~d]" (second term) (third term)))
    (:cat (format nil "(~a o ~a)" (cmr98-render (second term)) (cmr98-render (third term))))
    (:cut (format nil "(~a)^(~d,~d)" (cmr98-render (second term)) (third term) (fourth term)))))
(defun cmr98-piece (piece)
  (destructuring-bind (key lo len) piece
    (if (eq (first key) :const) (format nil "bvec~d[~d]" (second key) len)
        (format nil "(~a)^(~d,~d)" (second key) (1- (+ lo len)) lo))))
(defun cmr98-composition (pieces)
  (reduce (lambda (low high) (format nil "(~a o ~a)" high low))
          (mapcar #'cmr98-piece pieces)))
(defun cmr98-equality (a b) (format nil "(~a)=(~a)" a b))
(defun cmr98-check-normalization (claim)
  ;; Branch 2 proves the proposed identity from definitions alone. Branch 1
  ;; retains it. Extra branches are subtype obligations, discharged by ASSERT.
  `(branch (case ,claim)
     ((skip) (then (hide-all-but 1) (cmr98-normalization$)) (assert))))
(defun cmr98-compile (max-columns)
  (let (equations targets)
    (dolist (sf (s-forms (current-goal *ps*)))
      (let* ((form (formula sf)) (negative (negation? form))
             (eqn (if negative (args1 form) form)))
        (when (and (equation? eqn) (cmr98-width (args1 eqn)))
          (let ((pair (list (cmr98-ast (args1 eqn)) (cmr98-ast (args2 eqn)))))
            (if negative (push pair equations) (push pair targets))))))
    (setf equations (nreverse equations) targets (nreverse targets))
    ;; Proving any consequent is sufficient. The others remain in the sequent.
    (setf targets (subseq targets 0 (min 1 (length targets))))
    (unless (or equations targets) (error "No CMR equations in the sequent"))
    (multiple-value-bind (edges goal-edges) (cmr98:certificate-plan equations targets :max-columns max-columns)
      (let ((steps nil) (claims (make-hash-table :test #'equal)))
        (labels ((normalization (a b)
                   (let ((claim (cmr98-equality a b)))
                     (unless (gethash claim claims)
                       (setf (gethash claim claims) t)
                       (push (cmr98-check-normalization claim) steps)))))
          (dolist (edge edges)
            (destructuring-bind (num lo len a b) edge
              (let* ((eqn (nth num equations)) (n (cmr98:width (first eqn)))
                     (left (cmr98-render (first eqn))) (right (cmr98-render (second eqn)))
                     (pa (cmr98-piece a)) (pb (cmr98-piece b)))
                (normalization (format nil "(~a)^(~d,~d)" left (1- (+ lo len)) lo) pa)
                (normalization (format nil "(~a)^(~d,~d)" right (1- (+ lo len)) lo) pb)
                (push `(branch (case ,(cmr98-equality pa pb))
                         ((skip)
                          (then (lemma ,(format nil "cmr98_bv[~d,1,1].project_equal" n)
                                       ("a" ,left "b" ,right "lo" ,(write-to-string lo)
                                        "k" ,(write-to-string len)))
                                (expand "slice" -1) (assert))
                          (assert))) steps))))
          (when targets
            (let ((eqn (first targets)))
              (normalization (cmr98-render (first eqn))
                             (cmr98-composition (mapcar #'fourth goal-edges)))
              (normalization (cmr98-render (second eqn))
                             (cmr98-composition (mapcar #'fifth goal-edges)))))
          ;; A nonempty all-zero column cannot equal an all-one column.
          (dolist (len (remove-duplicates (mapcar #'third edges)))
            (push `(lemma ,(format nil "cmr98_bv[~d,1,1].constant_conflict" len)) steps))
          (push '(assert) steps)
          (format-if "~%CMR certificate: ~d source columns, ~d target columns, ~d normalizations.~%"
                     (length edges) (length goal-edges) (hash-table-count claims))
          `(then ,@(nreverse steps)))))))

(defstep cmr98-normalization ()
  (then (skosimp*) (expand* "slice" "O" "^" "bvec0" "bvec1")
        (apply-extensionality$ :hide? t)
        (repeat* (then (skosimp*) (beta) (lift-if) (assert) (bddsimp))))
  "Check a proposed composition/extraction identity by primitive semantic steps."
  "Checking CMR normalization")
(defstep cmr98-columns (&optional (max-columns 4096))
  (let ((script (handler-case (cmr98-compile max-columns)
                  (error (c) `(skip-msg ,(format nil "CMR: ~a" c))))))
    script)
  "Compile shared-column reasoning into checked PVS steps. Unsupported inputs stay open."
  "Checking a CMR column certificate")
(defstep cmr98-bv (&optional (max-columns 4096))
  (then (skosimp*) (cmr98-columns$ max-columns))
  "Prove concrete-width composition/extraction equations with a replayable CMR certificate."
  "Solving bitvector equations using CMR columns")

(defstep cmr98-solved-form (&optional (max-columns 4096))
  (let ((message
          (handler-case
              (let ((equations nil) (cmr98:*last-statistics* nil))
                (dolist (sf (neg-s-forms (s-forms (current-goal *ps*))))
                  (let ((eqn (args1 (formula sf))))
                    (when (and (equation? eqn) (cmr98-width (args1 eqn)))
                      (push (list (cmr98-ast (args1 eqn)) (cmr98-ast (args2 eqn))) equations))))
                (let ((answer (cmr98:solve (nreverse equations) :max-columns max-columns)))
                  (format nil "Candidate only (fresh keys are existential): ~s~%~s"
                          answer cmr98:*last-statistics*)))
            (error (c) (format nil "CMR: ~a" c)))))
    (skip-msg message t))
  "Inspect the pure interval solver's candidate solved form; proves nothing."
  "Inspecting a candidate CMR solved form")

;; Preview uses the same compiler as the strategy; no proof command is executed.
(when (boundp '*agent-preview-providers*)
  (setf (gethash "cmr98" *agent-preview-providers*) (lambda () (cmr98-compile 4096))))
